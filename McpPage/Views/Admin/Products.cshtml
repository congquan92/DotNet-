@model IEnumerable<McpPage.Data.Entities.Product>
@{
    ViewData["Title"] = "Quản Lý Sản Phẩm - MCP Shop Admin";
    var categories = ViewBag.Categories as List<McpPage.Data.Entities.Category> ?? new();
}

<div>
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0 text-dark">🏷️ Quản Lý Kho Hàng & Sản Phẩm</h3>
            <p class="text-muted small m-0 mt-1">Danh sách sản phẩm lưu hành trong hệ thống</p>
        </div>
        <a asp-controller="Admin" asp-action="CreateProduct" class="btn btn-success fw-bold">
            <i class="bi bi-plus-circle me-1"></i> Thêm Sản Phẩm Mới
        </a>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-white rounded-4 p-3 shadow-sm border border-light mb-3">
        <form method="get" asp-controller="Admin" asp-action="Products" class="row g-2 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo tên sản phẩm..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-12 col-md-4">
                <select name="categoryId" class="form-select form-select-sm">
                    <option value="">-- Tất cả danh mục --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id" selected="@(ViewBag.CategoryId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-cps-red btn-sm flex-grow-1">Lọc sản phẩm</button>
                <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-secondary btn-sm">Đặt lại</a>
            </div>
        </form>
    </div>

    <!-- Products Table -->
    <div class="bg-white rounded-4 p-3 shadow-sm border border-light">
        <div class="table-responsive">
            <table class="table table-hover align-middle small m-0">
                <thead class="table-light text-uppercase">
                    <tr>
                        <th style="width: 50px;">Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-center">Tồn kho</th>
                        <th class="text-center" style="width: 140px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@item.ImageUrl" alt="@item.Name" 
                                     style="width: 48px; height: 48px; object-fit: contain;" class="rounded border p-1"
                                     onerror="this.src='https://placehold.co/80x80?text=No+Img'" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.Name</div>
                                <div class="text-muted text-truncate" style="max-width: 320px; font-size: 0.75rem;">@item.Description</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@(item.Category?.Name ?? "Chung")</span>
                            </td>
                            <td class="text-end fw-bold text-danger">
                                @string.Format("{0:N0} đ", item.Price)
                            </td>
                            <td class="text-center">
                                <span class="badge @(item.Stock > 15 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                    @item.Stock chiếc
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@item.Id" 
                                       class="btn btn-outline-primary btn-sm px-2 py-1" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form method="post" asp-controller="Admin" asp-action="DeleteProduct" asp-route-id="@item.Id" 
                                          class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm px-2 py-1" title="Xóa">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
