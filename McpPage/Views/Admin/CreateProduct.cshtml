@model McpPage.Data.Entities.Product
@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới - MCP Shop Admin";
    var categories = ViewBag.Categories as List<McpPage.Data.Entities.Category> ?? new();
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-8">
            <div class="bg-white rounded-4 p-4 shadow-sm border border-light">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                    <h5 class="fw-bold m-0 text-dark">
                        <i class="bi bi-plus-circle-fill text-danger me-1"></i> Thêm Sản Phẩm Mới Vào Kho
                    </h5>
                    <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>

                <form method="post" asp-controller="Admin" asp-action="CreateProduct">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-semibold">Tên sản phẩm *</label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: iPhone 16 Pro Max 256GB..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="CategoryId" class="form-label small fw-semibold">Danh mục *</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="Price" class="form-label small fw-semibold">Giá bán (VNĐ) *</label>
                            <input asp-for="Price" type="number" step="1000" class="form-control" placeholder="Ví dụ: 25000000" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="Stock" class="form-label small fw-semibold">Số lượng tồn kho *</label>
                            <input asp-for="Stock" type="number" class="form-control" placeholder="Ví dụ: 50" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="ImageUrl" class="form-label small fw-semibold">Đường dẫn ảnh (URL)</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label small fw-semibold">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả tính năng nổi bật, thông số kỹ thuật..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Admin" asp-action="Products" class="btn btn-light px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-cps-red px-4 fw-bold">
                            <i class="bi bi-check2 me-1"></i> Lưu Sản Phẩm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
