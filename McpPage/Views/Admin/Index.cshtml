@model McpPage.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Bảng Điều Khiển Quản Trị - MCP Shop";
}

<div>
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0 text-dark">📊 Bảng Điều Khiển Quản Trị</h3>
            <p class="text-muted small m-0 mt-1">Tổng quan số liệu kinh doanh và trạng thái vận hành hệ thống</p>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Tổng Doanh Thu</span>
                        <h4 class="fw-bold text-danger m-0 mt-1">@string.Format("{0:N0} đ", Model.TotalRevenue)</h4>
                        <span class="text-success small fw-semibold"><i class="bi bi-graph-up-arrow"></i> Doanh thu thực tế</span>
                    </div>
                    <div class="cat-icon-circle m-0 bg-danger-subtle text-danger" style="width: 50px; height: 50px;">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Tổng Đơn Hàng</span>
                        <h4 class="fw-bold text-dark m-0 mt-1">@Model.TotalOrders đơn</h4>
                        <span class="text-muted small">Cập nhật thời gian thực</span>
                    </div>
                    <div class="cat-icon-circle m-0 bg-primary-subtle text-primary" style="width: 50px; height: 50px;">
                        <i class="bi bi-bag-check-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Tổng Sản Phẩm</span>
                        <h4 class="fw-bold text-dark m-0 mt-1">@Model.TotalProducts mặt hàng</h4>
                        <span class="text-muted small">Đang lưu hành trong kho</span>
                    </div>
                    <div class="cat-icon-circle m-0 bg-warning-subtle text-warning-emphasis" style="width: 50px; height: 50px;">
                        <i class="bi bi-box-seam-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Khách Hàng</span>
                        <h4 class="fw-bold text-dark m-0 mt-1">@Model.TotalCustomers thành viên</h4>
                        <span class="text-muted small">Đã lưu trong database</span>
                    </div>
                    <div class="cat-icon-circle m-0 bg-info-subtle text-info-emphasis" style="width: 50px; height: 50px;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content: Recent Orders & Low Stock -->
    <div class="row g-4">
        <!-- Recent Orders -->
        <div class="col-12 col-lg-8">
            <div class="bg-white rounded-4 p-4 shadow-sm border border-light h-100">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold m-0 text-dark"><i class="bi bi-clock-history text-danger me-1"></i> Đơn Hàng Mới Nhất</h5>
                    <a asp-controller="Admin" asp-action="Orders" class="small text-danger fw-semibold text-decoration-none">Xem tất cả &rarr;</a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>#Mã</th>
                                <th>Khách hàng</th>
                                <th>Thời gian</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="fw-bold text-danger">#@order.Id</td>
                                    <td>
                                        <div class="fw-semibold">@(order.Customer?.FullName ?? "Khách vãng lai")</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@(order.Customer?.Phone ?? "")</div>
                                    </td>
                                    <td class="text-muted">@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-bold">@string.Format("{0:N0} đ", order.TotalAmount)</td>
                                    <td>
                                        <span class="badge @(order.Status == "Completed" ? "bg-success" : (order.Status == "Processing" ? "bg-warning text-dark" : "bg-secondary"))">
                                            @order.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Low Stock Alerts -->
        <div class="col-12 col-lg-4">
            <div class="bg-white rounded-4 p-4 shadow-sm border border-light h-100">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold m-0 text-dark"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Cảnh Báo Tồn Kho</h5>
                    <a asp-controller="Admin" asp-action="Products" class="small text-danger fw-semibold text-decoration-none">Kho hàng &rarr;</a>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var prod in Model.LowStockProducts)
                    {
                        <div class="d-flex align-items-center gap-3 p-2 rounded-3 bg-light border">
                            <img src="@prod.ImageUrl" alt="@prod.Name" style="width: 45px; height: 45px; object-fit: contain;" class="rounded bg-white p-1" />
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="text-truncate fw-semibold small" title="@prod.Name">@prod.Name</div>
                                <span class="badge bg-danger-subtle text-danger" style="font-size: 0.72rem;">Còn lại: @prod.Stock chiếc</span>
                            </div>
                            <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@prod.Id" class="btn btn-outline-secondary btn-sm p-1 px-2" title="Chỉnh sửa">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
