@using Microsoft.AspNetCore.Identity
@using McpPage.Data.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var cartJson = Context.Session.GetString("CartSession");
    int cartCount = 0;
    if (!string.IsNullOrEmpty(cartJson))
    {
        try {
            var items = System.Text.Json.JsonSerializer.Deserialize<List<CartItem>>(cartJson);
            cartCount = items?.Sum(i => i.Quantity) ?? 0;
        } catch {}
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MCP Shop | Hệ Thống Bán Lẻ Công Nghệ Chính Hãng</title>
    
    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom CellphoneS Red-White Theme -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Announcement Bar -->
    <div class="bg-dark text-white py-1 px-3 small text-center d-none d-md-block" style="font-size: 0.8rem; letter-spacing: 0.3px;">
        🚀 Chào mừng đến với MCP Shop - Hệ thống bán lẻ công nghệ chính hãng | Giảm thêm 5% cho thành viên Smember | Trả góp 0% lãi suất
    </div>

    <!-- Main Red Header -->
    <header class="header-cps sticky-top py-2">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <!-- Brand Logo -->
                <a asp-controller="Home" asp-action="Index" class="brand-logo d-flex align-items-center text-decoration-none">
                    <i class="bi bi-cpu-fill me-2 fs-2"></i>
                    <span>MCP<span class="text-warning">SHOP</span></span>
                    <span class="logo-tag">OFFICIAL</span>
                </a>

                <!-- Search Bar (Form GET truyền thống) -->
                <div class="flex-grow-1 mx-2 mx-lg-4" style="max-width: 550px;">
                    <form method="get" asp-controller="Products" asp-action="Index" class="header-search-form m-0">
                        <input type="text" name="keyword" class="header-search-input" 
                               placeholder="Bạn tìm gì hôm nay? (iPhone, Laptop, Tai nghe...)" 
                               value="@Context.Request.Query["keyword"]" />
                        <button type="submit" class="header-search-btn" title="Tìm kiếm">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>

                <!-- Right Actions -->
                <div class="d-flex align-items-center gap-2">
                    <!-- Hotline Support -->
                    <div class="header-action-btn d-none d-xl-flex">
                        <i class="bi bi-telephone-inbound-fill fs-5 text-warning"></i>
                        <div class="small leading-tight">
                            <span class="d-block text-white-50" style="font-size: 0.72rem;">Gọi mua hàng</span>
                            <strong class="text-white">1800.2097</strong>
                        </div>
                    </div>

                    <!-- Cart Button -->
                    <a asp-controller="Cart" asp-action="Index" class="header-action-btn position-relative">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span class="d-none d-sm-inline fw-semibold">Giỏ hàng</span>
                        <span class="cart-badge">@cartCount</span>
                    </a>

                    <!-- User Account / Identity -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown">
                            <button class="header-action-btn dropdown-toggle border-0" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span class="d-none d-md-inline">@User.Identity?.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li class="dropdown-header">Xin chào, <strong>@User.Identity?.Name</strong></li>
                                <li><hr class="dropdown-divider"></li>
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <li>
                                        <a class="dropdown-item text-danger fw-bold" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-shield-lock-fill text-danger me-2"></i>Trang Quản Trị (Admin)
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Hồ sơ tài khoản</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-bag-check me-2"></i>Lịch sử đơn hàng</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-area="" asp-controller="Account" asp-action="Logout" class="m-0">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="header-action-btn">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span class="d-none d-md-inline fw-semibold">Tài khoản</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Sub-Navbar: Categories Quick Nav -->
    <nav class="header-subnav shadow-sm mb-3">
        <div class="container d-flex align-items-center overflow-x-auto py-1">
            <a asp-controller="Home" asp-action="Index" class="subnav-link">
                <i class="bi bi-house-door-fill text-danger"></i> Trang chủ
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a asp-controller="Admin" asp-action="Index" class="subnav-link text-danger fw-bold border-end pe-3 me-2">
                    <i class="bi bi-speedometer2 text-danger"></i> Quản trị Admin
                </a>
            }
            <a asp-controller="Products" asp-action="Index" class="subnav-link">
                <i class="bi bi-grid-fill text-danger"></i> Tất cả sản phẩm
            </a>
            <a asp-controller="Products" asp-action="Index" asp-route-categoryId="1" class="subnav-link">
                <i class="bi bi-laptop text-danger"></i> Laptop
            </a>
            <a asp-controller="Products" asp-action="Index" asp-route-categoryId="2" class="subnav-link">
                <i class="bi bi-phone text-danger"></i> Điện thoại & Tablet
            </a>
            <a asp-controller="Products" asp-action="Index" asp-route-categoryId="3" class="subnav-link">
                <i class="bi bi-keyboard text-danger"></i> Phụ kiện
            </a>
            <a asp-controller="Products" asp-action="Index" asp-route-categoryId="4" class="subnav-link">
                <i class="bi bi-headphones text-danger"></i> Âm thanh
            </a>
            <a asp-controller="Products" asp-action="Index" asp-route-categoryId="5" class="subnav-link">
                <i class="bi bi-smartwatch text-danger"></i> Đồng hồ thông minh
            </a>
        </div>
    </nav>

    <!-- Flash Notifications / TempData -->
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-3" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Body -->
    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <!-- Footer Chuẩn E-Commerce -->
    <footer class="footer-cps">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-12 col-md-3">
                    <h5 class="footer-heading">Tổng đài hỗ trợ</h5>
                    <ul class="footer-links">
                        <li>Gọi mua hàng: <span class="hotline-highlight">1800.2097</span> (8h00 - 22h00)</li>
                        <li>Khiếu nại, góp ý: <span class="hotline-highlight">1800.2063</span> (8h00 - 21h30)</li>
                        <li>Bảo hành sửa chữa: <span class="hotline-highlight">1800.2064</span> (8h00 - 21h00)</li>
                    </ul>
                    <div class="mt-3">
                        <span class="badge bg-danger p-2"><i class="bi bi-shield-check me-1"></i> 100% Hàng chính hãng</span>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <h5 class="footer-heading">Thông tin & Chính sách</h5>
                    <ul class="footer-links">
                        <li><a href="#">Mua hàng và thanh toán Online</a></li>
                        <li><a href="#">Mua hàng trả góp 0% Online</a></li>
                        <li><a href="#">Chính sách giao hàng toàn quốc</a></li>
                        <li><a href="#">Chính sách bảo hành đổi mới</a></li>
                        <li><a href="#">Chính sách bảo mật thông tin</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3">
                    <h5 class="footer-heading">Dịch vụ & Tiện ích</h5>
                    <ul class="footer-links">
                        <li><a href="#">Thu cũ đổi mới - Lên đời trợ giá</a></li>
                        <li><a href="#">Dịch vụ bảo hành mở rộng</a></li>
                        <li><a href="#">Chính sách thành viên Smember</a></li>
                        <li><a href="#">Hóa đơn điện tử VAT</a></li>
                        <li><a href="#">Tra cứu đơn hàng trực tuyến</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-3">
                    <h5 class="footer-heading">Phương thức thanh toán</h5>
                    <div class="d-flex flex-wrap gap-2 fs-3 text-secondary mb-3">
                        <i class="bi bi-credit-card-2-front" title="Thẻ ATM / Visa / Master"></i>
                        <i class="bi bi-qr-code" title="Chuyển khoản VNPAY / VietQR"></i>
                        <i class="bi bi-wallet2" title="Ví điện tử MoMo / ZaloPay"></i>
                        <i class="bi bi-cash-stack" title="Thanh toán khi nhận hàng (COD)"></i>
                    </div>
                    <h5 class="footer-heading">Kết nối với chúng tôi</h5>
                    <div class="d-flex gap-2 fs-5">
                        <a href="#" class="text-danger"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-danger"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="text-danger"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>
            </div>

            <hr class="my-3 text-muted" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-muted small">
                <div>
                    &copy; 2026 <strong>MCP Shop</strong> - Dự án E-Commerce ASP.NET Core MVC & PostgreSQL.
                </div>
                <div class="mt-2 mt-md-0">
                    Thiết kế chuẩn phong cách CellphoneS / Shopee Đỏ - Trắng năng động.
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap & Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
