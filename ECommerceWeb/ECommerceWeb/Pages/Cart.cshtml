@page
@model ECommerceWeb.Pages.CartModel
@{
    ViewData["Title"] = "Giỏ hàng";
    var currency = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="page-shell cart-page">
    <nav class="breadcrumb-nav" aria-label="Đường dẫn"><a asp-page="/Index">Trang chủ</a><span aria-hidden="true">/</span><span aria-current="page">Giỏ hàng</span></nav>
    <div class="section-heading"><div><p class="eyebrow">THÊM MỘT CHÚT CÔNG NGHỆ</p><h1>Giỏ hàng của bạn.</h1></div><p>@Model.Items.Sum(item => item.Quantity) sản phẩm</p></div>
    @if (TempData["Success"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (Model.Items.Count == 0)
    {
        <div class="empty-cart">
            <div class="empty-cart-icon"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z" /><path d="M8 8V6a4 4 0 0 1 8 0v2" /></svg></div>
            <h2>Giỏ hàng đang trống.</h2>
            <p>Chiếc điện thoại tiếp theo của bạn đang chờ được khám phá.</p>
            <a asp-page="/Index" asp-fragment="dien-thoai" class="button button-primary">Khám phá điện thoại <span aria-hidden="true">↗</span></a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                @foreach (var item in Model.Items)
                {
                    <article class="cart-item">
                        <a class="cart-image" asp-page="/Product" asp-route-id="@item.Product.Id"><img src="@item.Product.ImageUrl" alt="@item.Product.Name" width="120" height="120" /></a>
                        <div class="cart-product">
                            <p class="product-brand">@item.Product.Brand</p>
                            <h2><a asp-page="/Product" asp-route-id="@item.Product.Id">@item.Product.Name</a></h2>
                            <p class="cart-variant">@item.Product.Storage · @item.Product.Color</p>
                            <p class="cart-price">Đơn giá: @item.Product.Price.ToString("N0", currency) ₫</p>
                            <form method="post" asp-page-handler="Remove">
                                <input type="hidden" name="id" value="@item.Product.Id" />
                                <button type="submit" class="remove-button" aria-label="Xóa @item.Product.Name khỏi giỏ hàng">Xóa</button>
                            </form>
                        </div>
                        <div class="cart-item-quantity">
                            <form method="post" asp-page-handler="Update" class="quantity-form">
                                <input type="hidden" name="id" value="@item.Product.Id" />
                                <label for="quantity-@item.Product.Id">Số lượng</label>
                                <input id="quantity-@item.Product.Id" type="number" name="quantity" value="@item.Quantity" min="0" max="99" required aria-label="Số lượng @item.Product.Name" onchange="this.form.requestSubmit()" />
                            </form>
                            <strong class="cart-subtotal">@item.Subtotal.ToString("N0", currency) ₫</strong>
                        </div>
                    </article>
                }
                <a class="text-link continue-shopping" asp-page="/Index" asp-fragment="dien-thoai"><span aria-hidden="true">←</span> Tiếp tục khám phá</a>
            </div>
            <aside class="cart-summary" aria-labelledby="summary-title">
                <p class="eyebrow">THÊM MỘT BƯỚC NỮA</p>
                <h2 id="summary-title">Đơn hàng của bạn</h2>
                <div class="summary-line"><span>Số lượng sản phẩm</span><strong>@Model.Items.Sum(item => item.Quantity)</strong></div>
                <div class="summary-total"><span>Tổng tiền</span><strong>@Model.Total.ToString("N0", currency) ₫</strong></div>
                <form method="post" asp-page-handler="Checkout"><button type="submit" class="button button-primary">Đặt hàng <span aria-hidden="true">→</span></button></form>
                <p class="checkout-note">Đặt hàng thử, không phát sinh thanh toán.</p>
            </aside>
        </div>
    }
</div>
