<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#174f43" />
    <title>@ViewData["Title"] · Quản trị Mobi</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <a class="skip-link" href="#admin-content">Đến nội dung chính</a>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="brand admin-brand" asp-page="/Admin/Index" aria-label="Mobi — Trang quản trị">mobi<span>.</span></a>
            <p class="admin-sidebar-label">QUẢN TRỊ CỬA HÀNG</p>
            <nav class="admin-nav" aria-label="Điều hướng quản trị">
                <a class="admin-nav-active" asp-page="/Admin/Index" aria-current="page">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                    Tổng quan
                </a>
                <a href="#admin-products">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M10 5h4M11 19h2" /></svg>
                    Sản phẩm
                </a>
                <a asp-page="/Index">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 10v11h16V10M3 10l2-7h14l2 7M8 21v-7h8v7M3 10h18" /></svg>
                    Xem cửa hàng <span class="admin-nav-arrow" aria-hidden="true">↗</span>
                </a>
            </nav>
            <div class="admin-sidebar-bottom">
                <span class="admin-sidebar-rule"></span>
                <p>Công nghệ bạn thích.<br />Lựa chọn bạn cần.</p>
                <span>mobi / admin</span>
            </div>
        </aside>

        <div class="admin-workspace">
            <header class="admin-topbar">
                <div class="admin-breadcrumb"><span>Mobi</span><span aria-hidden="true">/</span><strong>Quản trị</strong></div>
                <div class="admin-account">
                    <div class="admin-account-name"><small>Đang đăng nhập</small><span>@User.Identity?.Name</span></div>
                    <form method="post" asp-page="/Admin/Logout">
                        <button class="admin-logout" type="submit">Đăng xuất <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 3H4v18h5M14 8l4 4-4 4M9 12h10" /></svg></button>
                    </form>
                </div>
            </header>
            <main class="admin-main" id="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
