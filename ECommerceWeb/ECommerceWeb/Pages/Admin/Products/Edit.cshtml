@page "/admin/products/edit/{id:int}"
@model ECommerceWeb.Pages.Admin.Products.EditModel
@{
    ViewData["Title"] = $"Chỉnh Sửa - {Model.Product.Name}";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="bg-white rounded-4 p-4 shadow-sm border border-light">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h5 class="fw-bold m-0 text-dark">
                    <i class="bi bi-pencil-square text-danger me-1"></i> Chỉnh Sửa Thông Tin Sản Phẩm #@Model.Product.Id
                </h5>
                <a asp-page="/Admin/Products/Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>

            <form method="post">
                <input type="hidden" asp-for="Product.Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-8">
                        <label asp-for="Product.Name" class="form-label small fw-semibold">Tên sản phẩm *</label>
                        <input asp-for="Product.Name" class="form-control" required />
                        <span asp-validation-for="Product.Name" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="Product.CategoryId" class="form-label small fw-semibold">Danh mục *</label>
                        <select asp-for="Product.CategoryId" class="form-select" required>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.Product.CategoryId)">@c.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-6 col-md-3">
                        <label asp-for="Product.Brand" class="form-label small fw-semibold">Thương hiệu</label>
                        <input asp-for="Product.Brand" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <label asp-for="Product.Storage" class="form-label small fw-semibold">Dung lượng</label>
                        <input asp-for="Product.Storage" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <label asp-for="Product.Color" class="form-label small fw-semibold">Màu sắc</label>
                        <input asp-for="Product.Color" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <label asp-for="Product.Stock" class="form-label small fw-semibold">Số lượng tồn kho *</label>
                        <input asp-for="Product.Stock" type="number" class="form-control" required />
                        <span asp-validation-for="Product.Stock" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="Product.Price" class="form-label small fw-semibold">Giá bán (VNĐ) *</label>
                        <input asp-for="Product.Price" type="number" step="1000" class="form-control" required />
                        <span asp-validation-for="Product.Price" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label asp-for="Product.OriginalPrice" class="form-label small fw-semibold">Giá niêm yết cũ (nếu có)</label>
                        <input asp-for="Product.OriginalPrice" type="number" step="1000" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Product.ImageUrl" class="form-label small fw-semibold">Đường dẫn hình ảnh (URL)</label>
                    <input asp-for="Product.ImageUrl" class="form-control" />
                </div>

                <div class="mb-4">
                    <label asp-for="Product.Description" class="form-label small fw-semibold">Mô tả sản phẩm</label>
                    <textarea asp-for="Product.Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="/Admin/Products/Index" class="btn btn-light px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-cps-red px-4 fw-bold">
                        <i class="bi bi-check2 me-1"></i> Cập Nhật Sản Phẩm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
