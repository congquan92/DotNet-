@page "/admin/orders"
@model ECommerceWeb.Pages.Admin.Orders.IndexModel
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng - Mobi Admin";
}

<div>
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0 text-dark">
                <i class="bi bi-receipt text-danger me-2"></i> Quản Lý Đơn Hàng
            </h3>
            <p class="text-muted small m-0 mt-1">Theo dõi, kiểm tra chi tiết và cập nhật tiến độ xử lý đơn hàng</p>
        </div>
    </div>

    <!-- Status Filter Buttons -->
    <div class="bg-white rounded-4 p-3 shadow-sm border border-light mb-3">
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="/Admin/Orders/Index" asp-route-status="All" 
               class="btn btn-sm @(Model.Status == "All" ? "btn-dark fw-bold" : "btn-outline-secondary")">
               Tất cả (@Model.Orders.Count)
            </a>
            <a asp-page="/Admin/Orders/Index" asp-route-status="Pending" 
               class="btn btn-sm @(Model.Status == "Pending" ? "btn-warning fw-bold text-dark" : "btn-outline-warning text-dark")">
               Chờ xác nhận (Pending)
            </a>
            <a asp-page="/Admin/Orders/Index" asp-route-status="Processing" 
               class="btn btn-sm @(Model.Status == "Processing" ? "btn-primary fw-bold" : "btn-outline-primary")">
               Đang giao (Processing)
            </a>
            <a asp-page="/Admin/Orders/Index" asp-route-status="Completed" 
               class="btn btn-sm @(Model.Status == "Completed" ? "btn-success fw-bold" : "btn-outline-success")">
               Hoàn thành (Completed)
            </a>
            <a asp-page="/Admin/Orders/Index" asp-route-status="Cancelled" 
               class="btn btn-sm @(Model.Status == "Cancelled" ? "btn-danger fw-bold" : "btn-outline-danger")">
               Đã hủy (Cancelled)
            </a>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="bg-white rounded-4 p-3 shadow-sm border border-light">
        @if (!Model.Orders.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
                <h5 class="fw-bold">Không có đơn hàng nào thuộc trạng thái này.</h5>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle small m-0">
                    <thead class="table-light text-uppercase">
                        <tr>
                            <th>#Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Địa chỉ nhận hàng</th>
                            <th>Sản phẩm trong đơn</th>
                            <th class="text-end">Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-center" style="width: 220px;">Cập nhật nhanh</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td class="fw-bold text-danger">#@order.Id</td>
                                <td>
                                    <div class="fw-bold text-dark">@(order.Customer?.FullName ?? "Khách vãng lai")</div>
                                    <div class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-telephone me-1"></i>@(order.Customer?.Phone ?? "---")</div>
                                    <div class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-clock me-1"></i>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 200px;" title="@order.ShippingAddress">
                                        @(string.IsNullOrEmpty(order.ShippingAddress) ? "Nhận tại cửa hàng" : order.ShippingAddress)
                                    </div>
                                </td>
                                <td>
                                    <div style="max-height: 80px; overflow-y: auto;">
                                        @foreach (var d in order.OrderDetails)
                                        {
                                            <div style="font-size: 0.75rem;">
                                                • @(d.Product?.Name ?? $"SP #{d.ProductId}") <span class="text-muted">(x@(d.Quantity))</span>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-danger fs-6">
                                    @order.TotalAmount.ToString("N0") đ
                                </td>
                                <td>
                                    <span class="badge @(order.Status == "Completed" ? "bg-success" : (order.Status == "Processing" ? "bg-primary" : (order.Status == "Pending" ? "bg-warning text-dark" : "bg-danger")))">
                                        @order.Status
                                    </span>
                                </td>
                                <td>
                                    <!-- Form Cập nhật trạng thái nhanh -->
                                    <form method="post" asp-page-handler="UpdateStatus" class="d-flex gap-1 align-items-center">
                                        <input type="hidden" name="id" value="@order.Id" />
                                        <select name="newStatus" class="form-select form-select-sm" style="font-size: 0.78rem;">
                                            <option value="Pending" selected="@(order.Status == "Pending")">Chờ duyệt</option>
                                            <option value="Processing" selected="@(order.Status == "Processing")">Đang giao</option>
                                            <option value="Completed" selected="@(order.Status == "Completed")">Hoàn thành</option>
                                            <option value="Cancelled" selected="@(order.Status == "Cancelled")">Hủy đơn</option>
                                        </select>
                                        <button type="submit" class="btn btn-outline-danger btn-sm px-2" title="Lưu trạng thái">
                                            <i class="bi bi-check2"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
