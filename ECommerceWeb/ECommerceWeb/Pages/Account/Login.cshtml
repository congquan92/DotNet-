@page
@model ECommerceWeb.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng Nhập - MOBI SHOP";
}

<div class="page-shell my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="p-4 text-white text-center" style="background: linear-gradient(135deg, #d70018, #b50014) !important;">
                    <div class="display-6 mb-1">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Đăng Nhập</h3>
                    <p class="text-white-50 small mb-0">Hệ thống xác thực ASP.NET Core Identity</p>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Username" class="form-label small fw-semibold">Tên đăng nhập</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="Input.Username" id="loginUsername" class="form-control py-2" placeholder="Nhập tên đăng nhập..." autofocus />
                            </div>
                            <span asp-validation-for="Input.Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label small fw-semibold">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                                <input asp-for="Input.Password" id="loginPassword" class="form-control py-2" placeholder="Nhập mật khẩu..." />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="Input.RememberMe" class="form-check-input" />
                                <label asp-for="Input.RememberMe" class="form-check-label small text-muted">Ghi nhớ đăng nhập</label>
                            </div>
                            <a href="#" class="small text-danger text-decoration-none">Quên mật khẩu?</a>
                        </div>

                        <button type="submit" class="btn btn-cps-red w-100 py-2 fw-bold shadow-sm mb-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                        </button>

                        <div class="text-center small text-muted">
                            Chưa có tài khoản? 
                            <a asp-page="/Account/Register" class="text-danger fw-semibold text-decoration-none">
                                Đăng ký ngay
                            </a>
                        </div>
                    </form>

                    <!-- Quick Login Demo Buttons (Bấm 1 click tự điền tài khoản để test) -->
                    <div class="border-top pt-3 mt-4 text-center">
                        <span class="badge bg-danger-subtle text-danger mb-2 small fw-semibold">
                            <i class="bi bi-lightning-fill"></i> Bấm để điền nhanh tài khoản test:
                        </span>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-outline-danger btn-sm text-start" onclick="fillLogin('admin', 'Admin@123')">
                                <i class="bi bi-person-gear me-1"></i> <strong>Admin:</strong> admin / Admin@123
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm text-start" onclick="fillLogin('user', 'User@123')">
                                <i class="bi bi-person me-1"></i> <strong>Khách hàng:</strong> user / User@123
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm text-start" onclick="fillLogin('user1', 'User@123')">
                                <i class="bi bi-person me-1"></i> <strong>Khách hàng (dự phòng):</strong> user1 / User@123
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillLogin(user, pass) {
            document.getElementById('loginUsername').value = user;
            document.getElementById('loginPassword').value = pass;
        }
    </script>
}
