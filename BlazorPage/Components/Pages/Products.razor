@page "/products"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CartService Cart
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Danh mục sản phẩm - Blazor E-Commerce</PageTitle>

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="fw-bold m-0">🛍️ Danh Sách Sản Phẩm</h2>
            <p class="text-muted small m-0">Hiển thị các sản phẩm có sẵn trong cơ sở dữ liệu PostgreSQL</p>
        </div>
        <div class="col-md-6 mt-3 mt-md-0">
            <!-- Search bar -->
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Tìm kiếm theo tên sản phẩm..."
                       @bind="searchKeyword" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                <button class="btn btn-primary" @onclick="ApplyFilter">
                    🔍 Tìm kiếm
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            ✅ @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar Filter -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm p-3 mb-4">
                <h5 class="fw-bold mb-3">📂 Danh Mục</h5>
                <div class="list-group list-group-flush">
                    <button class="list-group-item list-group-item-action border-0 rounded mb-1 @(selectedCategoryId == null ? "active bg-primary" : "")"
                            @onclick="() => SelectCategory(null)">
                        Tất cả sản phẩm
                    </button>
                    @if (categories != null)
                    {
                        @foreach (var cat in categories)
                        {
                            <button class="list-group-item list-group-item-action border-0 rounded mb-1 @(selectedCategoryId == cat.Id ? "active bg-primary" : "")"
                                    @onclick="() => SelectCategory(cat.Id)">
                                @cat.Name
                            </button>
                        }
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm p-3">
                <h5 class="fw-bold mb-3">💰 Sắp Xếp Giá</h5>
                <select class="form-select" @bind="sortOrder" @bind:after="ApplyFilter">
                    <option value="default">Mặc định (Mới nhất)</option>
                    <option value="price-asc">Giá: Thấp đến Cao</option>
                    <option value="price-desc">Giá: Cao đến Thấp</option>
                </select>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="col-lg-9">
            @if (displayedProducts == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Đang tải sản phẩm...</p>
                </div>
            }
            else if (displayedProducts.Count == 0)
            {
                <div class="card border-0 shadow-sm p-5 text-center">
                    <div class="fs-1 text-muted mb-2">🔍</div>
                    <h5 class="fw-bold">Không tìm thấy sản phẩm nào!</h5>
                    <p class="text-muted">Thử thay đổi từ khóa tìm kiếm hoặc chọn danh mục khác.</p>
                    <div>
                        <button class="btn btn-outline-primary" @onclick="ResetFilter">
                            Đặt lại bộ lọc
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <span class="text-muted small">
                        Tìm thấy <b>@(filteredProducts?.Count ?? 0)</b> sản phẩm 
                        @if (filteredProducts != null && filteredProducts.Count > 0)
                        {
                            <span>— Hiển thị <b>@((currentPage - 1) * pageSize + 1)</b> - <b>@Math.Min(currentPage * pageSize, filteredProducts.Count)</b></span>
                        }
                    </span>

                    <div class="d-flex align-items-center gap-2">
                        <label class="small text-muted mb-0">Hiển thị:</label>
                        <select class="form-select form-select-sm" style="width: auto;" @bind="pageSize" @bind:after="HandlePageSizeChange">
                            <option value="6">6 sản phẩm</option>
                            <option value="9">9 sản phẩm</option>
                            <option value="12">12 sản phẩm</option>
                        </select>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    @foreach (var prod in displayedProducts)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card h-100 border-0 shadow-sm overflow-hidden d-flex flex-column hover-shadow">
                                <a href="products/@prod.Id" class="text-decoration-none">
                                    <div class="bg-light d-flex align-items-center justify-content-center p-2" style="height: 200px;">
                                        <img src="@prod.ImageUrl" class="object-fit-contain w-100 h-100"
                                             alt="@prod.Name"
                                             onerror="this.src='https://placehold.co/400x300?text=No+Image'" />
                                    </div>
                                </a>
                                <div class="card-body d-flex flex-column p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge bg-secondary-subtle text-secondary small">
                                            @(prod.Category?.Name ?? "Chung")
                                        </span>
                                        <span class="badge bg-success-subtle text-success small">
                                            Còn: @prod.Stock
                                        </span>
                                    </div>

                                    <a href="products/@prod.Id" class="text-decoration-none text-dark">
                                        <h6 class="card-title fw-bold text-truncate" title="@prod.Name">@prod.Name</h6>
                                    </a>
                                    <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @prod.Description
                                    </p>

                                    <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <span class="fs-5 fw-bold text-danger">@prod.Price.ToString("N0") đ</span>
                                        <div class="d-flex align-items-center gap-1">
                                            @if (Auth.IsLoggedIn)
                                            {
                                                <button class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1"
                                                        @onclick="() => HandleAddToCart(prod)" title="Thêm vào giỏ">
                                                    + Giỏ hàng
                                                </button>
                                                <button class="btn btn-sm btn-danger rounded-pill px-2 py-1 fw-semibold shadow-sm"
                                                        @onclick="() => HandleBuyNow(prod)" title="Mua ngay">
                                                    ⚡ Mua ngay
                                                </button>
                                            }
                                            else
                                            {
                                                <a href="products/@prod.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1">
                                                    👁️ Chi tiết
                                                </a>
                                                <a href="login" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1 fw-semibold">
                                                    ⚡ Mua ngay
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination Bar -->
                @if (totalPages > 1)
                {
                    <nav class="d-flex justify-content-center mt-4" aria-label="Page navigation">
                        <ul class="pagination shadow-sm">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(1)" title="Trang đầu">&laquo;</button>
                            </li>
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="PrevPage" title="Trang trước">&lsaquo;</button>
                            </li>

                            @for (int p = 1; p <= totalPages; p++)
                            {
                                var pageNum = p;
                                <li class="page-item @(pageNum == currentPage ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="NextPage" title="Trang sau">&rsaquo;</button>
                            </li>
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(totalPages)" title="Trang cuối">&raquo;</button>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "category")]
    public int? QueryCategory { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }

    private List<Category>? categories;
    private List<Product>? allProducts;
    private List<Product>? filteredProducts;
    private List<Product>? displayedProducts;

    private int? selectedCategoryId;
    private string searchKeyword = string.Empty;
    private string sortOrder = "default";
    private string? successMessage;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 6;
    private int totalPages => filteredProducts == null || filteredProducts.Count == 0 ? 1 : (int)Math.Ceiling((double)filteredProducts.Count / pageSize);

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        categories = await context.Categories.OrderBy(c => c.Name).ToListAsync();
        allProducts = await context.Products.Include(p => p.Category).ToListAsync();

        if (QueryCategory.HasValue)
        {
            selectedCategoryId = QueryCategory.Value;
        }

        if (!string.IsNullOrWhiteSpace(QuerySearch))
        {
            searchKeyword = QuerySearch;
        }

        ApplyFilter();
    }

    private void SelectCategory(int? catId)
    {
        selectedCategoryId = catId;
        ApplyFilter();
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ApplyFilter();
        }
    }

    private void ApplyFilter()
    {
        if (allProducts == null) return;

        var query = allProducts.AsEnumerable();

        if (selectedCategoryId.HasValue)
        {
            query = query.Where(p => p.CategoryId == selectedCategoryId.Value);
        }

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            query = query.Where(p => p.Name.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) ||
                                     p.Description.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase));
        }

        query = sortOrder switch
        {
            "price-asc" => query.OrderBy(p => p.Price),
            "price-desc" => query.OrderByDescending(p => p.Price),
            _ => query.OrderByDescending(p => p.Id)
        };

        filteredProducts = query.ToList();
        currentPage = 1;
        UpdatePagedProducts();
    }

    private void UpdatePagedProducts()
    {
        if (filteredProducts == null)
        {
            displayedProducts = null;
            return;
        }

        if (currentPage < 1) currentPage = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        displayedProducts = filteredProducts
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void GoToPage(int page)
    {
        currentPage = page;
        UpdatePagedProducts();
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            UpdatePagedProducts();
        }
    }

    private void PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            UpdatePagedProducts();
        }
    }

    private void HandlePageSizeChange()
    {
        currentPage = 1;
        UpdatePagedProducts();
    }

    private void ResetFilter()
    {
        selectedCategoryId = null;
        searchKeyword = string.Empty;
        sortOrder = "default";
        ApplyFilter();
    }

    private void HandleAddToCart(Product product)
    {
        if (!Auth.IsLoggedIn)
        {
            Navigation.NavigateTo("login");
            return;
        }
        Cart.AddToCart(product, 1);
        successMessage = $"Đã thêm \"{product.Name}\" vào giỏ hàng!";
    }

    private void HandleBuyNow(Product product)
    {
        if (!Auth.IsLoggedIn)
        {
            Navigation.NavigateTo("login");
            return;
        }
        Cart.AddToCart(product, 1);
        Navigation.NavigateTo("cart");
    }
}
