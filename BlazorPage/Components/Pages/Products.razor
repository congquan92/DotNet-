@page "/products"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CartService Cart
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Danh mục sản phẩm - CellphoneS Style</PageTitle>

<div class="container my-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-danger text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="products" class="text-danger text-decoration-none">Sản phẩm</a></li>
            @if (selectedCategory != null)
            {
                <li class="breadcrumb-item active" aria-current="page">@selectedCategory.Name</li>
            }
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="row g-4">
        <!-- ==========================================
             SIDEBAR BỘ LỌC TÌM KIẾM
             ========================================== -->
        <div class="col-12 col-lg-3">
            <div class="bg-white rounded-4 p-3 shadow-sm border border-light">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold m-0 fs-6"><i class="bi bi-funnel-fill text-danger me-1"></i> Bộ Lọc Tìm Kiếm</h5>
                    <button class="btn btn-link small text-muted text-decoration-none p-0" @onclick="ResetFilter">Xóa lọc</button>
                </div>

                <!-- 1. Lọc theo Danh mục -->
                <div class="mb-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">Danh mục</label>
                    <div class="d-flex flex-column gap-1">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="catFilter" id="cat_all"
                                   checked="@(selectedCategoryId == null)"
                                   @onchange="@(() => SelectCategory(null))" />
                            <label class="form-check-label small" for="cat_all">Tất cả danh mục</label>
                        </div>
                        @if (categories != null)
                        {
                            @foreach (var cat in categories)
                            {
                                var currentCatId = cat.Id;
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="catFilter" id="@($"cat_{currentCatId}")"
                                           checked="@(selectedCategoryId == currentCatId)"
                                           @onchange="@(() => SelectCategory(currentCatId))" />
                                    <label class="form-check-label small" for="@($"cat_{currentCatId}")">@cat.Name</label>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- 2. Lọc theo Khoảng giá -->
                <div class="mb-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">Khoảng giá</label>
                    <div class="d-flex flex-column gap-1">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="priceRangeFilter" id="pr_all"
                                   checked="@(string.IsNullOrEmpty(priceRange))"
                                   @onchange="@(() => SelectPriceRange(string.Empty))" />
                            <label class="form-check-label small" for="pr_all">Tất cả mức giá</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="priceRangeFilter" id="pr_u5"
                                   checked="@(priceRange == "under5m")"
                                   @onchange="@(() => SelectPriceRange("under5m"))" />
                            <label class="form-check-label small" for="pr_u5">Dưới 5 triệu</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="priceRangeFilter" id="pr_5_15"
                                   checked="@(priceRange == "5m-15m")"
                                   @onchange="@(() => SelectPriceRange("5m-15m"))" />
                            <label class="form-check-label small" for="pr_5_15">5 - 15 triệu</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="priceRangeFilter" id="pr_15_30"
                                   checked="@(priceRange == "15m-30m")"
                                   @onchange="@(() => SelectPriceRange("15m-30m"))" />
                            <label class="form-check-label small" for="pr_15_30">15 - 30 triệu</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="priceRangeFilter" id="pr_a30"
                                   checked="@(priceRange == "above30m")"
                                   @onchange="@(() => SelectPriceRange("above30m"))" />
                            <label class="form-check-label small" for="pr_a30">Trên 30 triệu</label>
                        </div>
                    </div>
                </div>

                <!-- 3. Sắp xếp -->
                <div class="mb-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">Sắp xếp theo</label>
                    <select class="form-select form-select-sm" @bind="sortBy" @bind:after="ApplyFilter">
                        <option value="default">Mới nhất</option>
                        <option value="price_asc">Giá tăng dần</option>
                        <option value="price_desc">Giá giảm dần</option>
                        <option value="name_asc">Tên A-Z</option>
                    </select>
                </div>

                <button type="button" class="btn btn-cps-red w-100 py-2" @onclick="ApplyFilter">
                    <i class="bi bi-funnel me-1"></i> Áp dụng bộ lọc
                </button>
            </div>
        </div>

        <!-- ==========================================
             DANH SÁCH SẢN PHẨM (Grid)
             ========================================== -->
        <div class="col-12 col-lg-9">
            <!-- Header bar -->
            <div class="bg-white rounded-4 p-3 shadow-sm border border-light mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="fw-bold m-0 text-dark">
                        @(selectedCategory?.Name ?? "Tất cả sản phẩm")
                    </h5>
                    <span class="text-muted small">Tìm thấy <strong>@(filteredProducts?.Count ?? 0)</strong> sản phẩm</span>
                    @if (!string.IsNullOrEmpty(searchKeyword))
                    {
                        <span class="badge bg-danger-subtle text-danger ms-2">Từ khóa: "@searchKeyword"</span>
                    }
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">Hiển thị:</label>
                    <select class="form-select form-select-sm" style="width: auto;" @bind="pageSize" @bind:after="HandlePageSizeChange">
                        <option value="6">6 sản phẩm</option>
                        <option value="9">9 sản phẩm</option>
                        <option value="12">12 sản phẩm</option>
                    </select>
                </div>
            </div>

            @if (displayedProducts == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-danger" role="status"></div>
                    <p class="text-muted mt-2">Đang tải sản phẩm...</p>
                </div>
            }
            else if (!displayedProducts.Any())
            {
                <div class="bg-white rounded-4 p-5 text-center shadow-sm">
                    <i class="bi bi-box2 text-muted" style="font-size: 4rem;"></i>
                    <h5 class="fw-bold mt-3">Không tìm thấy sản phẩm phù hợp</h5>
                    <p class="text-muted small">Vui lòng thử lại với các tiêu chí hoặc mức giá khác.</p>
                    <button class="btn btn-cps-red btn-sm px-4" @onclick="ResetFilter">
                        Xem tất cả sản phẩm
                    </button>
                </div>
            }
            else
            {
                <div class="row row-cols-2 row-cols-md-3 g-3 mb-4">
                    @foreach (var prod in displayedProducts)
                    {
                        <div class="col">
                            <div class="product-card">
                                <span class="badge-discount">-12%</span>
                                <span class="badge-installment">Trả góp 0%</span>

                                <a href="products/@prod.Id" class="product-image-box">
                                    <img src="@prod.ImageUrl" alt="@prod.Name" loading="lazy"
                                         onerror="this.src='https://placehold.co/400x300?text=No+Image'" />
                                </a>

                                <div class="product-info">
                                    <a href="products/@prod.Id" class="product-title" title="@prod.Name">
                                        @prod.Name
                                    </a>

                                    <div class="product-price-box">
                                        <div class="d-flex align-items-baseline">
                                            <span class="product-price">@string.Format("{0:N0} đ", prod.Price)</span>
                                            <span class="product-original-price">@string.Format("{0:N0} đ", prod.Price * 1.12m)</span>
                                        </div>
                                    </div>

                                    <div class="product-promo-box">
                                        <i class="bi bi-check-circle-fill text-success me-1"></i> Sẵn hàng tại cửa hàng
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <div class="product-rating">
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <span class="review-count">(5.0)</span>
                                        </div>
                                        <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">Kho: @prod.Stock</span>
                                    </div>

                                    <div class="mt-3 pt-2 border-top d-flex gap-2">
                                        <button class="btn btn-cps-red btn-sm flex-grow-1 fw-bold"
                                                @onclick="() => HandleBuyNow(prod)">
                                            <i class="bi bi-lightning-fill"></i> Mua ngay
                                        </button>
                                        <button class="btn btn-cps-outline btn-sm px-2"
                                                @onclick="() => HandleAddToCart(prod)" title="Thêm vào giỏ">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination Bar -->
                @if (totalPages > 1)
                {
                    <nav class="d-flex justify-content-center mt-4" aria-label="Page navigation">
                        <ul class="pagination shadow-sm">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link text-dark" @onclick="() => GoToPage(1)" title="Trang đầu">&laquo;</button>
                            </li>
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link text-dark" @onclick="PrevPage" title="Trang trước">&lsaquo;</button>
                            </li>

                            @for (int p = 1; p <= totalPages; p++)
                            {
                                var pageNum = p;
                                <li class="page-item @(pageNum == currentPage ? "active" : "")">
                                    <button class="page-link @(pageNum == currentPage ? "bg-danger border-danger text-white" : "text-dark")"
                                            @onclick="() => GoToPage(pageNum)">
                                        @pageNum
                                    </button>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link text-dark" @onclick="NextPage" title="Trang sau">&rsaquo;</button>
                            </li>
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link text-dark" @onclick="() => GoToPage(totalPages)" title="Trang cuối">&raquo;</button>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "category")]
    public int? QueryCategory { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }

    private List<Category>? categories;
    private List<Product>? allProducts;
    private List<Product>? filteredProducts;
    private List<Product>? displayedProducts;

    private int? selectedCategoryId;
    private Category? selectedCategory => categories?.FirstOrDefault(c => c.Id == selectedCategoryId);
    private string searchKeyword = string.Empty;
    private string priceRange = string.Empty;
    private string sortBy = "default";
    private string? successMessage;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 9;
    private int totalPages => filteredProducts == null || filteredProducts.Count == 0 ? 1 : (int)Math.Ceiling((double)filteredProducts.Count / pageSize);

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        categories = await context.Categories.OrderBy(c => c.Name).ToListAsync();
        allProducts = await context.Products.Include(p => p.Category).ToListAsync();

        if (QueryCategory.HasValue)
        {
            selectedCategoryId = QueryCategory.Value;
        }

        if (!string.IsNullOrWhiteSpace(QuerySearch))
        {
            searchKeyword = QuerySearch;
        }

        ApplyFilter();
    }

    private void SelectCategory(int? catId)
    {
        selectedCategoryId = catId;
        ApplyFilter();
    }

    private void SelectPriceRange(string range)
    {
        priceRange = range;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (allProducts == null) return;

        var query = allProducts.AsEnumerable();

        if (selectedCategoryId.HasValue)
        {
            query = query.Where(p => p.CategoryId == selectedCategoryId.Value);
        }

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            query = query.Where(p => p.Name.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase) ||
                                     (p.Description != null && p.Description.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrEmpty(priceRange))
        {
            query = priceRange switch
            {
                "under5m" => query.Where(p => p.Price < 5_000_000m),
                "5m-15m" => query.Where(p => p.Price >= 5_000_000m && p.Price <= 15_000_000m),
                "15m-30m" => query.Where(p => p.Price > 15_000_000m && p.Price <= 30_000_000m),
                "above30m" => query.Where(p => p.Price > 30_000_000m),
                _ => query
            };
        }

        query = sortBy switch
        {
            "price_asc" => query.OrderBy(p => p.Price),
            "price_desc" => query.OrderByDescending(p => p.Price),
            "name_asc" => query.OrderBy(p => p.Name),
            _ => query.OrderByDescending(p => p.Id)
        };

        filteredProducts = query.ToList();
        currentPage = 1;
        UpdatePagedProducts();
    }

    private void UpdatePagedProducts()
    {
        if (filteredProducts == null)
        {
            displayedProducts = null;
            return;
        }

        if (currentPage < 1) currentPage = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        displayedProducts = filteredProducts
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void GoToPage(int page)
    {
        currentPage = page;
        UpdatePagedProducts();
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            UpdatePagedProducts();
        }
    }

    private void PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            UpdatePagedProducts();
        }
    }

    private void HandlePageSizeChange()
    {
        currentPage = 1;
        UpdatePagedProducts();
    }

    private void ResetFilter()
    {
        selectedCategoryId = null;
        searchKeyword = string.Empty;
        priceRange = string.Empty;
        sortBy = "default";
        ApplyFilter();
    }

    private void HandleAddToCart(Product product)
    {
        Cart.AddToCart(product, 1);
        successMessage = $"Đã thêm \"{product.Name}\" vào giỏ hàng!";
    }

    private void HandleBuyNow(Product product)
    {
        Cart.AddToCart(product, 1);
        Navigation.NavigateTo("cart");
    }
}
