@page "/admin"
@page "/admin/dashboard"
@layout AdminLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Bảng Điều Khiển Quản Trị - Blazor Shop</PageTitle>

<div>
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0 text-dark">
                <i class="bi bi-speedometer2 text-danger me-1"></i> Bảng Điều Khiển Quản Trị
            </h3>
            <p class="text-muted small m-0 mt-1">Tổng quan số liệu kinh doanh và trạng thái vận hành hệ thống</p>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Tổng Doanh Thu</span>
                        <h4 class="fw-bold text-danger m-0 mt-1">@totalRevenue.ToString("N0") đ</h4>
                        <span class="text-success small fw-semibold"><i class="bi bi-graph-up-arrow"></i> Doanh thu thực tế</span>
                    </div>
                    <div class="cat-icon-circle m-0 bg-danger-subtle text-danger" style="width: 50px; height: 50px; flex-shrink: 0;">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Tổng Đơn Hàng</span>
                        <h4 class="fw-bold text-dark m-0 mt-1">@totalOrders đơn</h4>
                        <span class="text-muted small">Cập nhật thời gian thực</span>
                    </div>
                    <div class="cat-icon-circle m-0 bg-primary-subtle text-primary" style="width: 50px; height: 50px; flex-shrink: 0;">
                        <i class="bi bi-bag-check-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Số Sản Phẩm</span>
                        <h4 class="fw-bold text-dark m-0 mt-1">@totalProducts mặt hàng</h4>
                        <span class="text-muted small">Đang lưu hành trong kho</span>
                    </div>
                    <div class="cat-icon-circle m-0 bg-warning-subtle text-warning-emphasis" style="width: 50px; height: 50px; flex-shrink: 0;">
                        <i class="bi bi-box-seam-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold">Khách Hàng</span>
                        <h4 class="fw-bold text-dark m-0 mt-1">@totalCustomers thành viên</h4>
                        <span class="text-muted small">Đã lưu trong database</span>
                    </div>
                    <div class="cat-icon-circle m-0 bg-info-subtle text-info-emphasis" style="width: 50px; height: 50px; flex-shrink: 0;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Đơn hàng gần đây -->
    <div class="bg-white rounded-4 p-4 shadow-sm border border-light">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <h5 class="fw-bold m-0 text-dark">
                <i class="bi bi-clock-history text-danger me-1"></i> Đơn Hàng Gần Đây
            </h5>
            <a href="admin/orders" class="small text-danger fw-semibold text-decoration-none">
                Xem tất cả đơn hàng &rarr;
            </a>
        </div>

        @if (recentOrders == null)
        {
            <div class="text-center py-4 text-muted">
                <div class="spinner-border spinner-border-sm text-danger me-2" role="status"></div>
                Đang tải dữ liệu...
            </div>
        }
        else if (recentOrders.Count == 0)
        {
            <div class="text-muted text-center py-4">Chưa có đơn hàng nào trong hệ thống.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#Mã Đơn</th>
                            <th>Khách Hàng</th>
                            <th>Ngày Đặt</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in recentOrders)
                        {
                            <tr>
                                <td class="fw-bold">#@order.Id</td>
                                <td>@(order.Customer?.FullName ?? "Khách vãng lai")</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") đ</td>
                                <td>
                                    <span class="badge @GetStatusBadge(order.Status) px-2 py-1">
                                        @order.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private decimal totalRevenue = 0;
    private int totalOrders = 0;
    private int totalProducts = 0;
    private int totalCustomers = 0;
    private List<Order>? recentOrders;

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        totalOrders = await context.Orders.CountAsync();
        totalProducts = await context.Products.CountAsync();
        totalCustomers = await context.Customers.CountAsync();
        totalRevenue = await context.Orders
            .Where(o => o.Status != "Cancelled")
            .SumAsync(o => (decimal?)o.TotalAmount) ?? 0;

        recentOrders = await context.Orders
            .Include(o => o.Customer)
            .OrderByDescending(o => o.OrderDate)
            .Take(5)
            .ToListAsync();
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Pending" => "bg-warning-subtle text-warning-emphasis fw-semibold",
        "Processing" => "bg-primary-subtle text-primary fw-semibold",
        "Completed" => "bg-success-subtle text-success fw-semibold",
        "Cancelled" => "bg-danger-subtle text-danger fw-semibold",
        _ => "bg-secondary-subtle text-secondary fw-semibold"
    };
}
