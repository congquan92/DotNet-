@page "/admin/orders"
@layout AdminLayout
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Quản lý đơn hàng - Admin</PageTitle>

<div class="mb-4">
    <h2 class="fw-bold m-0">📦 Quản Lý Đơn Hàng</h2>
    <p class="text-muted small">Theo dõi và cập nhật trạng thái các đơn đặt hàng trong hệ thống</p>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ @statusMessage
        <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
    </div>
}

<div class="card border-0 shadow-sm bg-white p-4">
    @if (orders == null)
    {
        <div class="text-center py-4 text-muted">Đang tải danh sách đơn hàng...</div>
    }
    else if (orders.Count == 0)
    {
        <div class="text-center py-5 text-muted">Chưa có đơn hàng nào trong database.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Số Điện Thoại</th>
                        <th>Địa Chỉ Nhận</th>
                        <th>Ngày Đặt</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in orders)
                    {
                        <tr>
                            <td class="fw-bold">#@order.Id</td>
                            <td>@(order.Customer?.FullName ?? "N/A")</td>
                            <td>@(order.Customer?.Phone ?? "N/A")</td>
                            <td class="small text-truncate" style="max-width: 200px;" title="@order.ShippingAddress">
                                @order.ShippingAddress
                            </td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") đ</td>
                            <td>
                                <select class="form-select form-select-sm"
                                        value="@order.Status"
                                        @onchange="(e) => UpdateOrderStatus(order, e.Value?.ToString() ?? order.Status)">
                                    <option value="Pending">Chờ xử lý (Pending)</option>
                                    <option value="Processing">Đang xử lý (Processing)</option>
                                    <option value="Completed">Hoàn tất (Completed)</option>
                                    <option value="Cancelled">Đã hủy (Cancelled)</option>
                                </select>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-info" @onclick="() => ViewOrderDetails(order)">
                                    🔍 Chi tiết
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal xem chi tiết đơn hàng -->
@if (selectedOrder != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Chi Tiết Đơn Hàng #@selectedOrder.Id</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => selectedOrder = null"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <p class="mb-1"><b>Khách hàng:</b> @(selectedOrder.Customer?.FullName ?? "N/A")</p>
                            <p class="mb-1"><b>Số điện thoại:</b> @(selectedOrder.Customer?.Phone ?? "N/A")</p>
                            <p class="mb-1"><b>Email:</b> @(selectedOrder.Customer?.Email ?? "N/A")</p>
                        </div>
                        <div class="col-sm-6">
                            <p class="mb-1"><b>Ngày đặt:</b> @selectedOrder.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-1"><b>Địa chỉ nhận hàng:</b> @selectedOrder.ShippingAddress</p>
                            <p class="mb-1"><b>Trạng thái:</b> <span class="badge bg-primary">@selectedOrder.Status</span></p>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-2">Danh sách sản phẩm trong đơn:</h6>
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in selectedOrder.OrderDetails)
                            {
                                <tr>
                                    <td>@(item.Product?.Name ?? $"Sản phẩm #{item.ProductId}")</td>
                                    <td class="text-center">@item.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end fw-bold">@((item.UnitPrice * item.Quantity).ToString("N0")) đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Tổng cộng:</th>
                                <th class="text-end text-danger fs-5">@selectedOrder.TotalAmount.ToString("N0") đ</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => selectedOrder = null">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Order>? orders;
    private Order? selectedOrder;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        orders = await context.Orders
            .Include(o => o.Customer)
            .Include(o => o.OrderDetails)
            .ThenInclude(od => od.Product)
            .OrderByDescending(o => o.OrderDate)
            .ToListAsync();
    }

    private async Task UpdateOrderStatus(Order order, string newStatus)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var dbOrder = await context.Orders.FindAsync(order.Id);
        if (dbOrder != null)
        {
            dbOrder.Status = newStatus;
            await context.SaveChangesAsync();
            order.Status = newStatus;
            statusMessage = $"Đã cập nhật đơn hàng #{order.Id} sang trạng thái: {newStatus}";
        }
    }

    private void ViewOrderDetails(Order order)
    {
        selectedOrder = order;
    }
}
