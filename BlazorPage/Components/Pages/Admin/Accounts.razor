@page "/admin/accounts"
@layout AdminLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@inject IServiceProvider ServiceProvider
@inject AuthService Auth

<PageTitle>Quản lý tài khoản - Admin</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0">🔐 Quản Lý Tài Khoản</h2>
        <p class="text-muted small m-0">Quản lý tài khoản người dùng ASP.NET Core Identity và trạng thái hoạt động</p>
    </div>
    <button class="btn btn-primary fw-semibold" @onclick="OpenAddModal">
        + Thêm Tài Khoản Mới
    </button>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        ✅ @statusMessage
        <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
    </div>
}

<div class="card border-0 shadow-sm bg-white p-4">
    @if (accounts == null)
    {
        <div class="text-center py-4 text-muted">Đang tải danh sách tài khoản...</div>
    }
    else if (accounts.Count == 0)
    {
        <div class="text-center py-5 text-muted">Chưa có tài khoản nào.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tên Đăng Nhập</th>
                        <th>Họ Tên Khách Hàng</th>
                        <th>Email</th>
                        <th>Vai Trò (Role)</th>
                        <th>Trạng Thái</th>
                        <th class="text-center" style="width: 220px;">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acc in accounts)
                    {
                        <tr>
                            <td class="fw-semibold">@acc.Username</td>
                            <td>@(acc.Customer?.FullName ?? acc.FullName ?? "(Chưa liên kết hồ sơ)")</td>
                            <td class="small text-muted">@(acc.Email ?? "—")</td>
                            <td>
                                @if (acc.Role == "Admin")
                                {
                                    <span class="badge bg-danger">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">User</span>
                                }
                            </td>
                            <td>
                                @if (!acc.IsLocked)
                                {
                                    <span class="badge bg-success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Đã khóa</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (acc.Username == "admin" || (Auth.CurrentUser != null && acc.Id == Auth.CurrentUser.Id))
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" disabled title="Tài khoản Admin hệ thống">
                                        🛡️ Hệ thống
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger me-1"
                                            @onclick="() => OpenDeleteModal(acc)"
                                            title="Xóa tài khoản và hồ sơ khách hàng">
                                        🗑️ Xóa
                                    </button>
                                }
                                <button class="btn btn-sm @(!acc.IsLocked ? "btn-outline-warning" : "btn-outline-success")"
                                        @onclick="() => ToggleStatus(acc)"
                                        disabled="@(acc.Username == "admin")"
                                        title="@(!acc.IsLocked ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                    @(!acc.IsLocked ? "🔒 Khóa" : "🔓 Mở")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Xác Nhận Xóa Tài Khoản -->
@if (showDeleteModal && accountToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-danger text-white p-3">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <span>⚠️</span>
                        <span>Xác Nhận Xóa Tài Khoản Identity</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal" disabled="@isDeleting"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 shadow-sm border-0">
                        <span class="fs-4">🚨</span>
                        <div class="small fw-semibold">
                            CẢNH BÁO: Hành động này KHÔNG THỂ HOÀN TÁC! Toàn bộ tài khoản và dữ liệu liên quan sẽ bị xóa khỏi hệ thống.
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm p-3 mb-3 bg-white rounded-3">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">Thông tin tài khoản sẽ xóa:</h6>
                        <div class="row g-2 small">
                            <div class="col-4 text-muted">Tên đăng nhập:</div>
                            <div class="col-8 fw-bold text-primary">@accountToDelete.Username</div>
                            <div class="col-4 text-muted">Vai trò:</div>
                            <div class="col-8"><span class="badge bg-primary">@accountToDelete.Role</span></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white border-top">
                    <button type="button" class="btn btn-secondary px-3" @onclick="CloseDeleteModal" disabled="@isDeleting">
                        Hủy Bỏ
                    </button>
                    <button type="button" class="btn btn-danger px-4 fw-bold" @onclick="ConfirmDeleteAccount" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Đang xóa...</span>
                        }
                        else
                        {
                            <span>Xóa Vĩnh Viễn</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Thêm Tài Khoản Mới -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Thêm Tài Khoản Mới</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên đăng nhập (Username) *</label>
                        <input type="text" class="form-control" @bind="newUsername" placeholder="ví dụ: user2..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Họ và tên *</label>
                        <input type="text" class="form-control" @bind="newFullName" placeholder="ví dụ: Nguyễn Văn B..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mật khẩu *</label>
                        <input type="password" class="form-control" @bind="newPassword" placeholder="Nhập mật khẩu..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Vai trò (Role) *</label>
                        <select class="form-select" @bind="newRole">
                            <option value="User">User (Người dùng thường)</option>
                            <option value="Admin">Admin (Quản trị viên)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Hủy bỏ</button>
                    <button type="button" class="btn btn-primary px-3" @onclick="CreateAccount">Tạo Tài Khoản</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public class UserAccountDto
    {
        public string Id { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string? FullName { get; set; }
        public string? Email { get; set; }
        public string Role { get; set; } = "User";
        public bool IsLocked { get; set; }
        public Customer? Customer { get; set; }
    }

    private List<UserAccountDto>? accounts;
    private bool showModal = false;
    private string newUsername = string.Empty;
    private string newFullName = string.Empty;
    private string newPassword = string.Empty;
    private string newRole = "User";
    private string? statusMessage;

    // Delete Modal State
    private UserAccountDto? accountToDelete;
    private bool showDeleteModal = false;
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        using var scope = ServiceProvider.CreateScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

        var users = await userManager.Users.AsNoTracking().ToListAsync();
        var customers = await db.Customers.AsNoTracking().ToListAsync();

        var list = new List<UserAccountDto>();
        foreach (var u in users)
        {
            var roles = await userManager.GetRolesAsync(u);
            var isLocked = await userManager.IsLockedOutAsync(u);
            var cust = customers.FirstOrDefault(c => c.UserId == u.Id);

            list.Add(new UserAccountDto
            {
                Id = u.Id,
                Username = u.UserName ?? string.Empty,
                FullName = u.FullName,
                Email = u.Email,
                Role = roles.FirstOrDefault() ?? "User",
                IsLocked = isLocked,
                Customer = cust
            });
        }

        accounts = list;
    }

    private void OpenAddModal()
    {
        newUsername = string.Empty;
        newFullName = string.Empty;
        newPassword = string.Empty;
        newRole = "User";
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task CreateAccount()
    {
        if (string.IsNullOrWhiteSpace(newUsername) || string.IsNullOrWhiteSpace(newPassword))
            return;

        using var scope = ServiceProvider.CreateScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

        var user = new ApplicationUser
        {
            UserName = newUsername.Trim(),
            FullName = newFullName.Trim(),
            Email = $"{newUsername.Trim()}@blazorshop.com",
            EmailConfirmed = true
        };

        var result = await userManager.CreateAsync(user, newPassword.Trim());
        if (result.Succeeded)
        {
            await userManager.AddToRoleAsync(user, newRole);

            var customer = new Customer
            {
                FullName = string.IsNullOrWhiteSpace(newFullName) ? newUsername.Trim() : newFullName.Trim(),
                Email = user.Email,
                Address = "Việt Nam",
                UserId = user.Id
            };
            db.Customers.Add(customer);
            await db.SaveChangesAsync();

            statusMessage = $"Đã tạo tài khoản \"{user.UserName}\" thành công!";
            showModal = false;
            await LoadAccounts();
        }
        else
        {
            statusMessage = string.Join("; ", result.Errors.Select(e => e.Description));
        }
    }

    private void OpenDeleteModal(UserAccountDto acc)
    {
        accountToDelete = acc;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        if (!isDeleting)
        {
            showDeleteModal = false;
            accountToDelete = null;
        }
    }

    private async Task ConfirmDeleteAccount()
    {
        if (accountToDelete == null) return;
        isDeleting = true;

        try
        {
            using var scope = ServiceProvider.CreateScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            var user = await userManager.FindByIdAsync(accountToDelete.Id);
            if (user != null)
            {
                var customer = await db.Customers.FirstOrDefaultAsync(c => c.UserId == user.Id);
                if (customer != null)
                {
                    db.Customers.Remove(customer);
                    await db.SaveChangesAsync();
                }

                await userManager.DeleteAsync(user);
                statusMessage = $"Đã xóa tài khoản \"{user.UserName}\" thành công!";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Lỗi khi xóa tài khoản: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
            showDeleteModal = false;
            accountToDelete = null;
            await LoadAccounts();
        }
    }

    private async Task ToggleStatus(UserAccountDto acc)
    {
        using var scope = ServiceProvider.CreateScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        var user = await userManager.FindByIdAsync(acc.Id);
        if (user != null)
        {
            var isLocked = await userManager.IsLockedOutAsync(user);
            if (isLocked)
            {
                await userManager.SetLockoutEndDateAsync(user, null);
                acc.IsLocked = false;
                statusMessage = $"Đã mở khóa tài khoản @{user.UserName}!";
            }
            else
            {
                await userManager.SetLockoutEndDateAsync(user, DateTimeOffset.UtcNow.AddYears(100));
                acc.IsLocked = true;
                statusMessage = $"Đã khóa tài khoản @{user.UserName}!";
            }
        }
    }
}
