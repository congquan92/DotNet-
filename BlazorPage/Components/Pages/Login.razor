@page "/login"
@rendermode InteractiveServer
@inject AuthService Auth
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Đăng nhập - Blazor E-Commerce</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-primary text-white p-4 text-center">
                    <div class="fs-1 mb-2">🔐</div>
                    <h4 class="fw-bold m-0">Đăng Nhập Hệ Thống</h4>
                    <p class="small text-white-50 m-0">Bảo mật Cookie HttpOnly (Không lưu LocalStorage)</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger small py-2 mb-3">
                            ⚠️ @errorMessage
                        </div>
                    }

                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <div class="small text-muted mt-2">Đang xác thực thông tin đăng nhập...</div>
                        </div>
                    }
                    else
                    {
                        <form @onsubmit="HandleLogin" @onsubmit:preventDefault>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Tên đăng nhập</label>
                                <input type="text" class="form-control" @bind="username" placeholder="Nhập username..." autofocus />
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-semibold">Mật khẩu</label>
                                <input type="password" class="form-control" @bind="password" placeholder="Nhập mật khẩu..." />
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3">
                                🔑 Đăng Nhập
                            </button>
                        </form>

                        <!-- Quick Login Demo Buttons (Rất tiện lợi để kiểm thử) -->
                        <div class="border-top pt-3 text-center">
                            <span class="badge bg-light text-muted mb-2">Đăng nhập nhanh để kiểm thử:</span>
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-danger btn-sm" @onclick="QuickLoginAdmin">
                                    👑 Đăng nhập Admin (admin / 123)
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="QuickLoginUser">
                                    👤 Đăng nhập Khách hàng (user1 / 123)
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string? errorMessage;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureInitializedAsync();
        if (Auth.IsLoggedIn)
        {
            Navigation.NavigateTo(Auth.IsAdmin ? "admin/dashboard" : "profile");
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Vui lòng nhập tên đăng nhập và mật khẩu!";
            return;
        }

        isLoading = true;
        try
        {
            var result = await JS.InvokeAsync<LoginJsResult>("window.cookieAuth.login", username.Trim(), password.Trim());
            if (result == null || !result.Success)
            {
                errorMessage = result?.Message ?? "Đăng nhập không thành công!";
                isLoading = false;
            }
            // Nếu success=true, script window.cookieAuth.login sẽ tự chuyển trang bằng window.location.href
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi xử lý đăng nhập: " + ex.Message;
            isLoading = false;
        }
    }

    private async Task QuickLoginAdmin()
    {
        username = "admin";
        password = "123";
        await HandleLogin();
    }

    private async Task QuickLoginUser()
    {
        username = "user1";
        password = "123";
        await HandleLogin();
    }

    private class LoginJsResult
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
    }
}
