@page "/products/{Id:int}"
@page "/product/{Id:int}"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CartService Cart
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>@(product?.Name ?? "Chi tiết sản phẩm") - Blazor E-Commerce</PageTitle>

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">🏠 Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="products" class="text-decoration-none">Sản phẩm</a></li>
            @if (product?.Category != null)
            {
                <li class="breadcrumb-item">
                    <a href="products?category=@product.Category.Id" class="text-decoration-none">
                        @product.Category.Name
                    </a>
                </li>
            }
            <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">
                @(product?.Name ?? "Đang tải...")
            </li>
        </ol>
    </nav>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Đang tải thông tin chi tiết sản phẩm...</p>
        </div>
    }
    else if (product == null)
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-white my-4 rounded-4">
            <div class="fs-1 text-danger mb-3">🔍</div>
            <h4 class="fw-bold">Không tìm thấy sản phẩm!</h4>
            <p class="text-muted">Sản phẩm bạn đang tìm kiếm không tồn tại hoặc đã ngừng kinh doanh.</p>
            <div class="mt-3">
                <a href="products" class="btn btn-primary px-4 py-2">
                    &larr; Quay lại danh sách sản phẩm
                </a>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
                ✅ @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        <!-- Hero Product Details Section -->
        <div class="card border-0 shadow-sm bg-white rounded-4 overflow-hidden p-4 mb-5">
            <div class="row g-4 align-items-center">
                <!-- Cột hình ảnh sản phẩm -->
                <div class="col-lg-5 text-center">
                    <div class="bg-light rounded-4 p-4 border d-flex align-items-center justify-content-center"
                         style="min-height: 380px;">
                        <img src="@product.ImageUrl" alt="@product.Name"
                             class="img-fluid object-fit-contain" style="max-height: 350px; width: 100%;"
                             onerror="this.src='https://placehold.co/500x500?text=No+Image'" />
                    </div>
                    <div class="d-flex justify-content-center gap-3 mt-3 text-muted small">
                        <span>🛡️ Chính hãng 100%</span>
                        <span>•</span>
                        <span>⚡ Giao siêu tốc</span>
                        <span>•</span>
                        <span>🔄 Đổi trả 7 ngày</span>
                    </div>
                </div>

                <!-- Cột thông tin & Đặt mua -->
                <div class="col-lg-7">
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill">
                            📂 @(product.Category?.Name ?? "Sản phẩm công nghệ")
                        </span>
                        @if (product.Stock > 0)
                        {
                            <span class="badge bg-success-subtle text-success fw-semibold px-3 py-2 rounded-pill">
                                ✅ Còn hàng (@product.Stock sản phẩm sẵn có)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger fw-semibold px-3 py-2 rounded-pill">
                                ❌ Tạm hết hàng
                            </span>
                        }
                    </div>

                    <h2 class="fw-bold mb-2">@product.Name</h2>

                    <div class="d-flex align-items-baseline gap-3 mb-3">
                        <span class="fs-1 fw-bold text-danger">@product.Price.ToString("N0") đ</span>
                        <span class="text-decoration-line-through text-muted">@((product.Price * 1.15m).ToString("N0")) đ</span>
                        <span class="badge bg-danger small">-15%</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-4 border">
                        <h6 class="fw-bold mb-1 text-dark">Mô tả sản phẩm:</h6>
                        <p class="text-secondary small m-0 lh-base">
                            @product.Description
                        </p>
                    </div>

                    <!-- Mua hàng hoặc Bắt buộc đăng nhập -->
                    @if (Auth.IsLoggedIn)
                    {
                        <!-- Khi đã đăng nhập: Có nút chọn số lượng & Mua hàng -->
                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-muted">Số lượng mua:</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="input-group" style="width: 140px;">
                                    <button class="btn btn-outline-secondary" type="button"
                                            @onclick="DecreaseQuantity" disabled="@(quantity <= 1)">
                                        -
                                    </button>
                                    <input type="number" class="form-control text-center fw-bold"
                                           @bind="quantity" min="1" max="@product.Stock" />
                                    <button class="btn btn-outline-secondary" type="button"
                                            @onclick="IncreaseQuantity" disabled="@(quantity >= product.Stock)">
                                        +
                                    </button>
                                </div>
                                <span class="small text-muted">Tối đa: @product.Stock sản phẩm</span>
                            </div>
                        </div>

                        <div class="d-flex gap-3 flex-wrap">
                            <button class="btn btn-outline-primary btn-lg px-4 py-2 fw-semibold rounded-pill d-flex align-items-center gap-2"
                                    @onclick="AddToCart" disabled="@(product.Stock <= 0)">
                                <span>🛒</span>
                                <span>Thêm Vào Giỏ</span>
                            </button>
                            <button class="btn btn-danger btn-lg px-5 py-2 fw-bold rounded-pill d-flex align-items-center gap-2 shadow"
                                    @onclick="BuyNow" disabled="@(product.Stock <= 0)">
                                <span>⚡</span>
                                <span>Mua Ngay</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- Khi chưa đăng nhập: Chế độ chỉ xem, thông báo yêu cầu đăng nhập -->
                        <div class="card border-warning bg-warning-subtle p-3 rounded-4 mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="fs-1">🔒</div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Chế độ xem dành cho khách</h6>
                                    <p class="small text-muted mb-0">
                                        Bạn cần đăng nhập tài khoản thành viên để thêm sản phẩm vào giỏ và đặt hàng.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="login" class="btn btn-primary btn-lg w-100 fw-bold py-3 rounded-pill shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <span>🔑</span>
                                <span>Đăng Nhập Để Mua Hàng</span>
                            </a>
                        </div>
                    }

                    <!-- Cam kết cửa hàng -->
                    <div class="row g-2 mt-4 pt-3 border-top">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2 small text-muted">
                                <span>🚚</span>
                                <span>Miễn phí vận chuyển toàn quốc</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2 small text-muted">
                                <span>🛡️</span>
                                <span>Bảo hành chính hãng 12 - 24 tháng</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2 small text-muted">
                                <span>🔄</span>
                                <span>1 đổi 1 trong 30 ngày nếu có lỗi</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2 small text-muted">
                                <span>📞</span>
                                <span>Hỗ trợ kỹ thuật trực tiếp 24/7</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thông số kỹ thuật & Chi tiết -->
        <div class="card border-0 shadow-sm bg-white rounded-4 p-4 mb-5">
            <h5 class="fw-bold mb-3 pb-2 border-bottom">📋 Thông Số Chi Tiết Sản Phẩm</h5>
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-striped table-bordered align-middle small mb-0">
                        <tbody>
                            <tr>
                                <th class="w-40 text-muted">Mã sản phẩm</th>
                                <td class="fw-bold">#SP-@product.Id</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Tên thiết bị</th>
                                <td>@product.Name</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Danh mục</th>
                                <td>@(product.Category?.Name ?? "Công nghệ điện tử")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table table-striped table-bordered align-middle small mb-0">
                        <tbody>
                            <tr>
                                <th class="w-40 text-muted">Tình trạng kho</th>
                                <td>@(product.Stock > 0 ? $"Còn {product.Stock} chiếc sẵn có" : "Tạm hết hàng")</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Giá niêm yết</th>
                                <td class="fw-bold text-danger">@product.Price.ToString("N0") VNĐ</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Bảo hành</th>
                                <td>12 Tháng Chính Hãng Toàn Quốc</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sản phẩm tương tự cùng danh mục -->
        @if (relatedProducts != null && relatedProducts.Count > 0)
        {
            <div class="mb-4">
                <h4 class="fw-bold mb-3">🔥 Sản Phẩm Tương Tự Cùng Danh Mục</h4>
                <div class="row g-3">
                    @foreach (var rel in relatedProducts)
                    {
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden d-flex flex-column">
                                <a href="products/@rel.Id" class="text-decoration-none">
                                    <div class="bg-light d-flex align-items-center justify-content-center p-2" style="height: 150px;">
                                        <img src="@rel.ImageUrl" class="object-fit-contain w-100 h-100"
                                             alt="@rel.Name"
                                             onerror="this.src='https://placehold.co/300x200?text=No+Image'" />
                                    </div>
                                </a>
                                <div class="card-body p-3 d-flex flex-column">
                                    <a href="products/@rel.Id" class="text-decoration-none text-dark">
                                        <h6 class="fw-bold text-truncate mb-1" title="@rel.Name">@rel.Name</h6>
                                    </a>
                                    <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-danger">@rel.Price.ToString("N0") đ</span>
                                        <a href="products/@rel.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2">
                                            Xem &rarr;
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;
    private List<Product>? relatedProducts;
    private bool isLoading = true;
    private int quantity = 1;
    private string? successMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductAsync();
    }

    private async Task LoadProductAsync()
    {
        isLoading = true;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            product = await context.Products
                .Include(p => p.Category)
                .FirstOrDefaultAsync(p => p.Id == Id);

            if (product != null)
            {
                relatedProducts = await context.Products
                    .Where(p => p.CategoryId == product.CategoryId && p.Id != product.Id)
                    .Take(4)
                    .ToListAsync();
            }
            quantity = 1;
            successMessage = null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadProductDetail Error]: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void IncreaseQuantity()
    {
        if (product != null && quantity < product.Stock)
        {
            quantity++;
        }
    }

    private void DecreaseQuantity()
    {
        if (quantity > 1)
        {
            quantity--;
        }
    }

    private void AddToCart()
    {
        if (!Auth.IsLoggedIn)
        {
            Navigation.NavigateTo("login");
            return;
        }

        if (product != null)
        {
            Cart.AddToCart(product, quantity);
            successMessage = $"Đã thêm {quantity} sản phẩm \"{product.Name}\" vào giỏ hàng thành công!";
        }
    }

    private void BuyNow()
    {
        if (!Auth.IsLoggedIn)
        {
            Navigation.NavigateTo("login");
            return;
        }

        if (product != null)
        {
            Cart.AddToCart(product, quantity);
            Navigation.NavigateTo("cart");
        }
    }
}
