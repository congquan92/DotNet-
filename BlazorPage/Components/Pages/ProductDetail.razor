@page "/products/{Id:int}"
@page "/product/{Id:int}"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject CartService Cart
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>@(product?.Name ?? "Chi tiết sản phẩm") - CellphoneS Style</PageTitle>

<div class="container my-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-danger text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="products" class="text-danger text-decoration-none">Sản phẩm</a></li>
            @if (product?.Category != null)
            {
                <li class="breadcrumb-item">
                    <a href="products?category=@product.Category.Id" class="text-danger text-decoration-none">
                        @product.Category.Name
                    </a>
                </li>
            }
            <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">
                @(product?.Name ?? "Đang tải...")
            </li>
        </ol>
    </nav>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="text-muted mt-2">Đang tải thông tin chi tiết sản phẩm...</p>
        </div>
    }
    else if (product == null)
    {
        <div class="bg-white rounded-4 p-5 text-center shadow-sm my-4">
            <i class="bi bi-box2 text-muted" style="font-size: 4rem;"></i>
            <h4 class="fw-bold mt-3">Không tìm thấy sản phẩm!</h4>
            <p class="text-muted small">Sản phẩm bạn đang tìm kiếm không tồn tại hoặc đã ngừng kinh doanh.</p>
            <div class="mt-3">
                <a href="products" class="btn btn-cps-red px-4 py-2">
                    &larr; Quay lại danh sách sản phẩm
                </a>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        <!-- Product Showcase -->
        <div class="bg-white rounded-4 p-4 shadow-sm border border-light mb-4">
            <div class="row g-4">
                <!-- Left: Product Image -->
                <div class="col-12 col-md-5 d-flex flex-column align-items-center justify-content-center p-3 border-end">
                    <div class="position-relative w-100 text-center p-3" style="max-height: 420px;">
                        <span class="badge-discount">-12%</span>
                        <span class="badge-installment">Trả góp 0%</span>
                        <img src="@product.ImageUrl" alt="@product.Name" class="img-fluid rounded-3"
                             style="max-height: 380px; object-fit: contain;"
                             onerror="this.src='https://placehold.co/500x500?text=No+Image'" />
                    </div>
                    <div class="d-flex flex-wrap justify-content-center gap-2 mt-3 text-muted small">
                        <span><i class="bi bi-shield-check text-success me-1"></i> Chính hãng 100%</span>
                        <span>•</span>
                        <span><i class="bi bi-arrow-repeat text-primary me-1"></i> 1 đổi 1 30 ngày</span>
                        <span>•</span>
                        <span><i class="bi bi-truck text-danger me-1"></i> Miễn phí giao hàng</span>
                    </div>
                </div>

                <!-- Right: Product Info & Purchase Form -->
                <div class="col-12 col-md-7 ps-md-4">
                    <span class="badge bg-danger-subtle text-danger fw-bold mb-2">@(product.Category?.Name ?? "Công nghệ")</span>
                    <h3 class="fw-bold mb-2 text-dark">@product.Name</h3>

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="product-rating">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <span class="text-dark fw-bold ms-1">5.0</span>
                            <span class="review-count">(128 đánh giá)</span>
                        </div>
                        <span class="text-muted">|</span>
                        <span class="badge @(product.Stock > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-2 py-1">
                            @(product.Stock > 0 ? $"Còn hàng ({product.Stock} sản phẩm)" : "Hết hàng")
                        </span>
                    </div>

                    <!-- Price Box -->
                    <div class="bg-light rounded-3 p-3 mb-3 border">
                        <div class="d-flex align-items-baseline gap-3 flex-wrap">
                            <span class="fs-2 fw-bold text-danger">@string.Format("{0:N0} đ", product.Price)</span>
                            <span class="text-muted text-decoration-line-through fs-6">@string.Format("{0:N0} đ", product.Price * 1.12m)</span>
                            <span class="badge bg-danger">Tiết kiệm @string.Format("{0:N0} đ", product.Price * 0.12m)</span>
                        </div>
                        <div class="small text-danger fw-semibold mt-1">
                            <i class="bi bi-gem me-1"></i> Giá ưu đãi đặc quyền cho thành viên Smember: giảm thêm 200.000đ
                        </div>
                    </div>

                    <!-- Promotion Box -->
                    <div class="border border-danger-subtle rounded-3 p-3 mb-4 bg-danger-subtle bg-opacity-10">
                        <h6 class="fw-bold text-danger mb-2"><i class="bi bi-gift-fill me-1"></i> Khuyến mãi đặc biệt</h6>
                        <ul class="small mb-0 ps-3 text-secondary">
                            <li>Tặng củ sạc nhanh GaN 65W hoặc túi chống sốc cao cấp.</li>
                            <li>Trợ giá thu cũ đổi mới lên đến 2.000.000đ.</li>
                            <li>Giảm 10% khi mua kèm phụ kiện (tai nghe, chuột, sạc dự phòng).</li>
                        </ul>
                    </div>

                    <!-- Purchase Actions -->
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <label class="fw-semibold small">Số lượng:</label>
                        <div class="input-group" style="width: 130px;">
                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="DecreaseQuantity">-</button>
                            <input type="number" class="form-control form-control-sm text-center" min="1" max="@product.Stock"
                                   @bind="quantity" />
                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="IncreaseQuantity">+</button>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-cps-red btn-lg flex-grow-1 fw-bold shadow-sm"
                                @onclick="BuyNow" disabled="@(product.Stock <= 0)">
                            <i class="bi bi-lightning-charge-fill me-1"></i> MUA NGAY
                            <div class="small fw-normal" style="font-size: 0.75rem;">Giao tận nơi hoặc nhận tại cửa hàng</div>
                        </button>
                        <button type="button" class="btn btn-cps-outline btn-lg px-4 fw-bold"
                                @onclick="AddToCart" disabled="@(product.Stock <= 0)">
                            <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                        </button>
                    </div>
                </div>
            </div>

            <hr class="my-4 text-muted" />

            <!-- Product Specs & Description -->
            <div class="row g-4">
                <div class="col-12 col-lg-8">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Đặc điểm nổi bật</h5>
                    <div class="text-secondary leading-relaxed mb-4">
                        <p>@product.Description</p>
                        <p>Sản phẩm chính hãng phân phối tại Việt Nam, nguyên seal 100% kèm đầy đủ phụ kiện từ nhà sản xuất. Hỗ trợ kích hoạt bảo hành điện tử chính hãng toàn quốc.</p>
                    </div>
                </div>
                <div class="col-12 col-lg-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Thông số kỹ thuật</h5>
                    <table class="table table-sm table-striped small border">
                        <tbody>
                            <tr>
                                <th class="w-50 bg-light">Mã sản phẩm</th>
                                <td>#SP-@product.Id</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Tên sản phẩm</th>
                                <td>@product.Name</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Danh mục</th>
                                <td>@(product.Category?.Name ?? "Chung")</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Bảo hành</th>
                                <td>12 tháng chính hãng</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Tình trạng</th>
                                <td>Mới 100% nguyên hộp</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Tồn kho</th>
                                <td>@product.Stock chiếc</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Related Products -->
        @if (relatedProducts != null && relatedProducts.Any())
        {
            <div class="mb-4">
                <h4 class="fw-bold mb-3 text-dark">Sản phẩm tương tự bạn có thể thích</h4>
                <div class="row row-cols-2 row-cols-md-4 g-3">
                    @foreach (var rel in relatedProducts)
                    {
                        <div class="col">
                            <div class="product-card">
                                <span class="badge-discount">-12%</span>
                                <span class="badge-installment">Trả góp 0%</span>

                                <a href="products/@rel.Id" class="product-image-box">
                                    <img src="@rel.ImageUrl" alt="@rel.Name" loading="lazy"
                                         onerror="this.src='https://placehold.co/400x300?text=No+Image'" />
                                </a>

                                <div class="product-info">
                                    <a href="products/@rel.Id" class="product-title" title="@rel.Name">
                                        @rel.Name
                                    </a>

                                    <div class="product-price-box">
                                        <div class="d-flex align-items-baseline">
                                            <span class="product-price">@string.Format("{0:N0} đ", rel.Price)</span>
                                            <span class="product-original-price">@string.Format("{0:N0} đ", rel.Price * 1.12m)</span>
                                        </div>
                                    </div>

                                    <div class="product-promo-box">
                                        <i class="bi bi-check-circle-fill text-success me-1"></i> Sẵn hàng tại cửa hàng
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <div class="product-rating">
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <span class="review-count">(5.0)</span>
                                        </div>
                                        <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">Kho: @rel.Stock</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Product? product;
    private List<Product>? relatedProducts;
    private bool isLoading = true;
    private int quantity = 1;
    private string? successMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductAsync();
    }

    private async Task LoadProductAsync()
    {
        isLoading = true;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            product = await context.Products
                .Include(p => p.Category)
                .FirstOrDefaultAsync(p => p.Id == Id);

            if (product != null)
            {
                relatedProducts = await context.Products
                    .Where(p => p.CategoryId == product.CategoryId && p.Id != product.Id)
                    .Take(4)
                    .ToListAsync();
            }
            quantity = 1;
            successMessage = null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadProductDetail Error]: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void IncreaseQuantity()
    {
        if (product != null && quantity < product.Stock)
        {
            quantity++;
        }
    }

    private void DecreaseQuantity()
    {
        if (quantity > 1)
        {
            quantity--;
        }
    }

    private void AddToCart()
    {
        if (product != null)
        {
            Cart.AddToCart(product, quantity);
            successMessage = $"Đã thêm {quantity} sản phẩm \"{product.Name}\" vào giỏ hàng thành công!";
        }
    }

    private void BuyNow()
    {
        if (product != null)
        {
            Cart.AddToCart(product, quantity);
            Navigation.NavigateTo("cart");
        }
    }
}
