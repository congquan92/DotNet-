@page "/cart"
@rendermode InteractiveServer
@inject CartService CartService
@inject AuthService Auth
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Giỏ hàng - Blazor E-Commerce</PageTitle>

<div class="container py-4">
    <h2 class="fw-bold mb-4">🛒 Giỏ Hàng Của Bạn</h2>

    @if (orderSuccessId.HasValue)
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-white my-4">
            <div class="fs-1 text-success mb-3">🎉</div>
            <h3 class="fw-bold text-success">Đặt Hàng Thành Công!</h3>
            <p class="lead text-muted">
                Cảm ơn bạn đã mua hàng. Mã đơn hàng của bạn là <b>#@orderSuccessId.Value</b>.
            </p>
            <p class="text-muted small">
                Đơn hàng đã được lưu trực tiếp vào cơ sở dữ liệu PostgreSQL. Bạn có thể xem trong trang quản trị Admin.
            </p>
            <div class="mt-3 d-flex justify-content-center gap-2 flex-wrap">
                <a href="products" class="btn btn-primary px-4">Tiếp tục mua sắm</a>
                <a href="profile" class="btn btn-outline-success px-4">📋 Xem đơn hàng của tôi</a>
                @if (Auth.IsAdmin)
                {
                    <a href="admin/orders" class="btn btn-outline-danger px-4">⚙️ Quản lý trong Admin</a>
                }
            </div>
        </div>
    }
    else if (CartService.Items.Count == 0)
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-white">
            <div class="fs-1 text-muted mb-3">🛍️</div>
            <h4 class="fw-bold">Giỏ hàng của bạn đang trống!</h4>
            <p class="text-muted">Hãy chọn cho mình những sản phẩm công nghệ yêu thích nhé.</p>
            <div>
                <a href="products" class="btn btn-primary px-4 py-2">
                    Khám phá sản phẩm ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Danh sách sản phẩm trong giỏ -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-3 bg-white">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th style="width: 130px;">Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in CartService.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.Product.ImageUrl" alt="@item.Product.Name"
                                                     class="rounded object-fit-contain bg-light p-1 border" style="width: 50px; height: 50px;"
                                                     onerror="this.src='https://placehold.co/50x50?text=SP'" />
                                                <div>
                                                    <h6 class="mb-0 fw-semibold">@item.Product.Name</h6>
                                                    <small class="text-muted">@(item.Product.Category?.Name ?? "Sản phẩm")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.Product.Price.ToString("N0") đ</td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <button class="btn btn-outline-secondary"
                                                        @onclick="() => CartService.UpdateQuantity(item.Product.Id, item.Quantity - 1)">
                                                    -
                                                </button>
                                                <span class="input-group-text bg-white px-3">@item.Quantity</span>
                                                <button class="btn btn-outline-secondary"
                                                        @onclick="() => CartService.UpdateQuantity(item.Product.Id, item.Quantity + 1)">
                                                    +
                                                </button>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-danger">@item.SubTotal.ToString("N0") đ</td>
                                        <td>
                                            <button class="btn btn-sm btn-link text-danger p-0" title="Xóa"
                                                    @onclick="() => CartService.RemoveFromCart(item.Product.Id)">
                                                ✕
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <button class="btn btn-outline-danger btn-sm" @onclick="CartService.ClearCart">
                            🗑️ Xóa toàn bộ giỏ hàng
                        </button>
                        <div class="text-end">
                            <span class="text-muted">Tổng cộng (@CartService.TotalItems món):</span>
                            <h4 class="fw-bold text-danger m-0">@CartService.TotalAmount.ToString("N0") đ</h4>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Đặt hàng -->
            <div class="col-lg-4">
                @if (!Auth.IsLoggedIn)
                {
                    <div class="card border-0 shadow-sm p-4 bg-white text-center rounded-4">
                        <div class="fs-1 text-warning mb-2">🔒</div>
                        <h5 class="fw-bold">Yêu Cầu Đăng Nhập Để Mua Hàng</h5>
                        <p class="text-muted small">
                            Hệ thống chỉ cho phép khách hàng có tài khoản thành viên thực hiện đặt hàng. Khách vãng lai chỉ có quyền xem sản phẩm.
                        </p>
                        <a href="login" class="btn btn-primary w-100 fw-bold py-2 mb-2 rounded-pill shadow-sm">
                            🔑 Đăng Nhập Ngay
                        </a>
                        <span class="small text-muted">Đăng nhập tài khoản để quản lý đơn hàng & giao dịch.</span>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm p-4 bg-white rounded-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="fw-bold m-0">📋 Thông Tin Nhận Hàng</h5>
                            <span class="badge bg-success-subtle text-success small">Tài khoản: @Auth.CurrentUser?.Username</span>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger small py-2">
                                ⚠️ @errorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Họ và tên người nhận *</label>
                            <input type="text" class="form-control" @bind="customerName" placeholder="Nguyễn Văn A" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Số điện thoại liên hệ *</label>
                            <input type="tel" class="form-control" @bind="customerPhone" placeholder="0901234567" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Email nhận hóa đơn</label>
                            <input type="email" class="form-control" @bind="customerEmail" placeholder="email@example.com" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-semibold">Địa chỉ giao hàng chi tiết *</label>
                            <textarea class="form-control" rows="2" @bind="customerAddress" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..."></textarea>
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-success btn-lg fw-bold py-2 rounded-pill shadow-sm" @onclick="HandleCheckout" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span>Đang xử lý đơn hàng...</span>
                                }
                                else
                                {
                                    <span>🚀 Đặt Hàng Ngay</span>
                                }
                            </button>
                        </div>

                        <p class="text-muted small text-center mt-3 mb-0">
                            🔒 Đơn hàng được gắn kết an toàn với tài khoản của bạn.
                        </p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private string customerName = string.Empty;
    private string customerPhone = string.Empty;
    private string customerEmail = string.Empty;
    private string customerAddress = string.Empty;

    private string? errorMessage;
    private int? orderSuccessId;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureInitializedAsync();
        if (Auth.IsLoggedIn && Auth.CurrentUser != null)
        {
            customerName = Auth.CurrentUser.FullName;
            customerPhone = Auth.CurrentUser.Phone;
            customerEmail = Auth.CurrentUser.Email;
            customerAddress = Auth.CurrentUser.Address;
        }
    }

    private async Task HandleCheckout()
    {
        errorMessage = null;

        if (!Auth.IsLoggedIn || Auth.CurrentUser == null)
        {
            errorMessage = "Hệ thống chỉ cho phép tài khoản thành viên đặt hàng. Vui lòng đăng nhập!";
            Navigation.NavigateTo("login");
            return;
        }

        if (string.IsNullOrWhiteSpace(customerName) || string.IsNullOrWhiteSpace(customerPhone) || string.IsNullOrWhiteSpace(customerAddress))
        {
            errorMessage = "Vui lòng điền đầy đủ Họ tên, Số điện thoại và Địa chỉ giao hàng!";
            return;
        }

        isSubmitting = true;

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            Customer? customer = null;
            if (Auth.IsLoggedIn && Auth.CurrentUser != null)
            {
                customer = await context.Customers.FirstOrDefaultAsync(c => c.AccountId == Auth.CurrentUser.Id);
            }
            if (customer == null)
            {
                customer = await context.Customers.FirstOrDefaultAsync(c => c.Phone == customerPhone.Trim());
            }

            if (customer == null)
            {
                customer = new Customer
                {
                    FullName = customerName.Trim(),
                    Phone = customerPhone.Trim(),
                    Email = string.IsNullOrWhiteSpace(customerEmail) ? $"{customerPhone.Trim()}@customer.local" : customerEmail.Trim(),
                    Address = customerAddress.Trim(),
                    AccountId = Auth.CurrentUser?.Id
                };
                context.Customers.Add(customer);
                await context.SaveChangesAsync();
            }
            else
            {
                customer.FullName = customerName.Trim();
                customer.Phone = customerPhone.Trim();
                customer.Address = customerAddress.Trim();
                if (!string.IsNullOrWhiteSpace(customerEmail))
                {
                    customer.Email = customerEmail.Trim();
                }
                if (customer.AccountId == null && Auth.CurrentUser != null)
                {
                    customer.AccountId = Auth.CurrentUser.Id;
                }
                await context.SaveChangesAsync();
            }

            var order = new Order
            {
                CustomerId = customer.Id,
                OrderDate = DateTime.UtcNow,
                TotalAmount = CartService.TotalAmount,
                Status = "Pending",
                ShippingAddress = customerAddress.Trim()
            };

            context.Orders.Add(order);
            await context.SaveChangesAsync();

            foreach (var item in CartService.Items)
            {
                var detail = new OrderDetail
                {
                    OrderId = order.Id,
                    ProductId = item.Product.Id,
                    Quantity = item.Quantity,
                    UnitPrice = item.Product.Price
                };
                context.OrderDetails.Add(detail);
            }

            await context.SaveChangesAsync();

            orderSuccessId = order.Id;
            CartService.ClearCart();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi lưu đơn hàng vào database: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
