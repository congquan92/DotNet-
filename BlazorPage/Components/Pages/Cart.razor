@page "/cart"
@rendermode InteractiveServer
@inject CartService CartService
@inject AuthService Auth
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Giỏ Hàng Của Bạn - Blazor Shop</PageTitle>

<div class="container my-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-danger text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active">Giỏ hàng</li>
        </ol>
    </nav>

    <h4 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
        <i class="bi bi-cart3 text-danger"></i> Giỏ Hàng Của Bạn
        @if (CartService.Items.Any())
        {
            <span class="badge bg-danger-subtle text-danger fs-6 fw-semibold">(@CartService.TotalItems sản phẩm)</span>
        }
    </h4>

    @if (orderSuccessId.HasValue)
    {
        <div class="bg-white rounded-4 p-5 text-center shadow-sm border border-light my-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4.5rem;"></i>
            <h3 class="fw-bold text-success mt-3">Đặt Hàng Thành Công!</h3>
            <p class="lead text-muted">
                Cảm ơn bạn đã mua hàng. Mã đơn hàng của bạn là <b>#@orderSuccessId.Value</b>.
            </p>
            <p class="text-muted small">
                Đơn hàng đã được lưu trực tiếp vào cơ sở dữ liệu PostgreSQL. Bạn có thể theo dõi trong hồ sơ cá nhân.
            </p>
            <div class="mt-4 d-flex justify-content-center gap-2 flex-wrap">
                <a href="products" class="btn btn-cps-red px-4">Tiếp tục mua sắm</a>
                <a href="profile" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-receipt me-1"></i> Xem đơn hàng của tôi
                </a>
            </div>
        </div>
    }
    else if (CartService.Items.Count == 0)
    {
        <div class="bg-white rounded-4 p-5 text-center shadow-sm border border-light">
            <i class="bi bi-cart-x text-muted" style="font-size: 4.5rem;"></i>
            <h5 class="fw-bold mt-3 text-dark">Giỏ hàng của bạn đang trống!</h5>
            <p class="text-muted small">Hãy chọn thêm những sản phẩm công nghệ tuyệt vời bạn yêu thích nhé.</p>
            <a href="products" class="btn btn-cps-red px-4 py-2 mt-2">
                <i class="bi bi-arrow-left me-1"></i> Khám phá sản phẩm ngay
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left: Cart Items Table -->
            <div class="col-12 col-lg-8">
                <div class="bg-white rounded-4 p-3 shadow-sm border border-light mb-3">
                    <div class="table-responsive">
                        <table class="table align-middle m-0">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th style="width: 45%;">Sản phẩm</th>
                                    <th class="text-center" style="width: 18%;">Đơn giá</th>
                                    <th class="text-center" style="width: 18%;">Số lượng</th>
                                    <th class="text-end" style="width: 19%;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in CartService.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.Product.ImageUrl" alt="@item.Product.Name" 
                                                     class="rounded border p-1" 
                                                     style="width: 60px; height: 60px; object-fit: contain;" />
                                                <div>
                                                    <a href="products/@item.Product.Id" class="fw-semibold text-dark text-decoration-none small d-block">
                                                        @item.Product.Name
                                                    </a>
                                                    <button type="button" class="btn btn-link text-danger p-0 small text-decoration-none border-0" 
                                                            @onclick="() => CartService.RemoveFromCart(item.Product.Id)">
                                                        <i class="bi bi-trash3 me-1"></i>Xóa
                                                    </button>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="text-center">
                                            <span class="fw-bold text-danger small">@item.Product.Price.ToString("N0") ₫</span>
                                        </td>

                                        <td class="text-center">
                                            <div class="d-flex justify-content-center align-items-center gap-1">
                                                <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                        @onclick="() => CartService.UpdateQuantity(item.Product.Id, item.Quantity - 1)">
                                                    -
                                                </button>
                                                <span class="px-2 fw-semibold">@item.Quantity</span>
                                                <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                        @onclick="() => CartService.UpdateQuantity(item.Product.Id, item.Quantity + 1)">
                                                    +
                                                </button>
                                            </div>
                                        </td>

                                        <td class="text-end">
                                            <strong class="text-danger">@item.SubTotal.ToString("N0") ₫</strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a href="products" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Xem thêm sản phẩm khác
                    </a>
                    <button class="btn btn-outline-danger btn-sm" @onclick="CartService.ClearCart">
                        <i class="bi bi-trash3 me-1"></i> Xóa toàn bộ giỏ
                    </button>
                </div>
            </div>

            <!-- Right: Order Summary & Checkout -->
            <div class="col-12 col-lg-4">
                <div class="bg-white rounded-4 p-4 shadow-sm border border-light mb-3">
                    <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">Tóm tắt đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Tổng số lượng:</span>
                        <span class="fw-bold">@CartService.TotalItems sản phẩm</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-bold">@CartService.TotalAmount.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span class="text-success fw-bold">MIỄN PHÍ</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <span class="fw-bold">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold text-danger">@CartService.TotalAmount.ToString("N0") ₫</span>
                    </div>
                    <div class="small text-muted text-end">(Đã bao gồm thuế VAT)</div>
                </div>

                <div class="bg-white rounded-4 p-4 shadow-sm border border-light">
                    <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                        <i class="bi bi-person-lines-fill text-danger me-1"></i> Thông tin giao hàng
                    </h5>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger small py-2">
                            ⚠️ @errorMessage
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Họ và tên người nhận *</label>
                        <input type="text" class="form-control" @bind="customerName" placeholder="Nguyễn Văn A" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Số điện thoại liên hệ *</label>
                        <input type="tel" class="form-control" @bind="customerPhone" placeholder="0901234567" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Email nhận hóa đơn</label>
                        <input type="email" class="form-control" @bind="customerEmail" placeholder="email@example.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Địa chỉ nhận hàng *</label>
                        <textarea class="form-control" rows="2" @bind="customerAddress" placeholder="Số nhà, tên đường, phường/xã..."></textarea>
                    </div>

                    <button class="btn btn-cps-red w-100 py-3 fw-bold fs-6 shadow" @onclick="HandleCheckout" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Đang xử lý đơn hàng...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-shield-lock-fill me-1"></i> XÁC NHẬN ĐẶT HÀNG</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string customerName = string.Empty;
    private string customerPhone = string.Empty;
    private string customerEmail = string.Empty;
    private string customerAddress = string.Empty;

    private string? errorMessage;
    private int? orderSuccessId;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureInitializedAsync();
        if (Auth.IsLoggedIn && Auth.CurrentUser != null)
        {
            customerName = Auth.CurrentUser.FullName;
            customerPhone = Auth.CurrentUser.Phone;
            customerEmail = Auth.CurrentUser.Email;
            customerAddress = Auth.CurrentUser.Address;
        }
    }

    private async Task HandleCheckout()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(customerName) || string.IsNullOrWhiteSpace(customerPhone) || string.IsNullOrWhiteSpace(customerAddress))
        {
            errorMessage = "Vui lòng điền đầy đủ Họ tên, Số điện thoại và Địa chỉ giao hàng!";
            return;
        }

        isSubmitting = true;

        try
        {
            await using AppDbContext? context = await DbFactory.CreateDbContextAsync();

            Customer? customer = null;
            if (Auth.IsLoggedIn && Auth.CurrentUser != null)
            {
                customer = await context.Customers.FirstOrDefaultAsync(c => c.UserId == Auth.CurrentUser.Id);
            }
            if (customer == null)
            {
                customer = await context.Customers.FirstOrDefaultAsync(c => c.Phone == customerPhone.Trim());
            }

            if (customer == null)
            {
                customer = new Customer
                {
                    FullName = customerName.Trim(),
                    Phone = customerPhone.Trim(),
                    Email = string.IsNullOrWhiteSpace(customerEmail) ? $"{customerPhone.Trim()}@customer.local" : customerEmail.Trim(),
                    Address = customerAddress.Trim(),
                    UserId = Auth.CurrentUser?.Id
                };
                context.Customers.Add(customer);
                await context.SaveChangesAsync();
            }
            else
            {
                customer.FullName = customerName.Trim();
                customer.Phone = customerPhone.Trim();
                customer.Address = customerAddress.Trim();
                if (!string.IsNullOrWhiteSpace(customerEmail))
                {
                    customer.Email = customerEmail.Trim();
                }
                if (customer.UserId == null && Auth.CurrentUser != null)
                {
                    customer.UserId = Auth.CurrentUser.Id;
                }
                await context.SaveChangesAsync();
            }

            var order = new Order
            {
                CustomerId = customer.Id,
                OrderDate = DateTime.UtcNow,
                TotalAmount = CartService.TotalAmount,
                Status = "Pending",
                ShippingAddress = customerAddress.Trim()
            };

            context.Orders.Add(order);
            await context.SaveChangesAsync();

            foreach (var item in CartService.Items)
            {
                var detail = new OrderDetail
                {
                    OrderId = order.Id,
                    ProductId = item.Product.Id,
                    Quantity = item.Quantity,
                    UnitPrice = item.Product.Price
                };
                context.OrderDetails.Add(detail);
            }

            await context.SaveChangesAsync();

            orderSuccessId = order.Id;
            CartService.ClearCart();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi lưu đơn hàng: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
