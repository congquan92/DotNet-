@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject CartService Cart
@inject AuthService Auth
@implements IDisposable

<div class="d-flex flex-column min-vh-100">
    <!-- Top Announcement Bar -->
    <div class="bg-dark text-white py-1 px-3 small text-center d-none d-md-block" style="font-size: 0.8rem; letter-spacing: 0.3px;">
        🚀 Chào mừng đến với Blazor Shop - Hệ thống bán lẻ công nghệ chính hãng | Giảm thêm 5% cho thành viên Smember | Trả góp 0% lãi suất
    </div>

    <!-- Main Red Header (CellphoneS Red-White) -->
    <header class="header-cps sticky-top py-2">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <!-- Brand Logo -->
                <a href="/" class="brand-logo d-flex align-items-center text-decoration-none">
                    <i class="bi bi-cpu-fill me-2 fs-2"></i>
                    <span>BLAZOR<span class="text-warning">SHOP</span></span>
                    <span class="logo-tag">OFFICIAL</span>
                </a>

                <!-- Search Bar -->
                <div class="flex-grow-1 mx-2 mx-lg-4" style="max-width: 550px;">
                    <form class="header-search-form m-0" @onsubmit="HandleSearch" @onsubmit:preventDefault>
                        <input type="text" class="header-search-input" 
                               placeholder="Bạn tìm gì hôm nay? (MacBook, iPhone, Tai nghe...)" 
                               @bind="searchKeyword" />
                        <button type="submit" class="header-search-btn" title="Tìm kiếm">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>

                <!-- Right Actions -->
                <div class="d-flex align-items-center gap-2">
                    <!-- Hotline Support -->
                    <div class="header-action-btn d-none d-xl-flex">
                        <i class="bi bi-telephone-inbound-fill fs-5 text-warning"></i>
                        <div class="small leading-tight">
                            <span class="d-block text-white-50" style="font-size: 0.72rem;">Gọi mua hàng</span>
                            <strong class="text-white">1800.2097</strong>
                        </div>
                    </div>

                    <!-- Cart Button -->
                    <a href="cart" class="header-action-btn position-relative">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span class="d-none d-sm-inline fw-semibold">Giỏ hàng</span>
                        <span class="cart-badge">@Cart.TotalItems</span>
                    </a>

                    <!-- User Account / Identity Dropdown -->
                    @if (Auth.IsLoggedIn)
                    {
                        <div class="dropdown">
                            <button class="header-action-btn dropdown-toggle border-0" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span class="d-none d-md-inline">@Auth.CurrentUser?.FullName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userMenu">
                                <li class="dropdown-header">
                                    Xin chào, <strong>@Auth.CurrentUser?.FullName</strong>
                                    <div class="small text-muted">(@Auth.CurrentUser?.Username)</div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                @if (Auth.IsAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item text-danger fw-bold" href="admin/dashboard">
                                            <i class="bi bi-shield-lock-fill text-danger me-2"></i>Trang Quản Trị (Admin)
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li>
                                    <a class="dropdown-item" href="profile">
                                        <i class="bi bi-person me-2"></i>Hồ sơ tài khoản
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="profile">
                                        <i class="bi bi-bag-check me-2"></i>Lịch sử đơn hàng
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="/api/auth/logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="login" class="header-action-btn">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span class="d-none d-md-inline fw-semibold">Tài khoản</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Sub-Navbar: Categories Quick Nav -->
    <nav class="header-subnav shadow-sm mb-3">
        <div class="container d-flex align-items-center overflow-x-auto py-1">
            <NavLink class="subnav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill text-danger"></i> Trang chủ
            </NavLink>
            @if (Auth.IsAdmin)
            {
                <a href="admin/dashboard" class="subnav-link text-danger fw-bold border-end pe-3 me-2">
                    <i class="bi bi-speedometer2 text-danger"></i> Quản trị Admin
                </a>
            }
            <NavLink class="subnav-link" href="products">
                <i class="bi bi-grid-fill text-danger"></i> Tất cả sản phẩm
            </NavLink>
            <a href="products?categoryId=1" class="subnav-link">
                <i class="bi bi-laptop text-danger"></i> Laptop
            </a>
            <a href="products?categoryId=2" class="subnav-link">
                <i class="bi bi-phone text-danger"></i> Điện thoại & Tablet
            </a>
            <a href="products?categoryId=3" class="subnav-link">
                <i class="bi bi-keyboard text-danger"></i> Phụ kiện
            </a>
            <a href="products?categoryId=4" class="subnav-link">
                <i class="bi bi-headphones text-danger"></i> Âm thanh
            </a>
            <NavLink class="subnav-link" href="cart">
                <i class="bi bi-cart-check text-danger"></i> Giỏ hàng
            </NavLink>
        </div>
    </nav>

    <!-- Main Body Canvas -->
    <main class="flex-grow-1 pb-4">
        @Body
    </main>

    <!-- Footer Chuẩn E-Commerce CellphoneS -->
    <footer class="footer-cps">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-12 col-md-3">
                    <h5 class="footer-heading">Tổng đài hỗ trợ</h5>
                    <ul class="footer-links">
                        <li>Gọi mua hàng: <span class="hotline-highlight">1800.2097</span> (8h00 - 22h00)</li>
                        <li>Khiếu nại, góp ý: <span class="hotline-highlight">1800.2063</span> (8h00 - 21h30)</li>
                        <li>Bảo hành sửa chữa: <span class="hotline-highlight">1800.2064</span> (8h00 - 21h00)</li>
                    </ul>
                    <div class="mt-3">
                        <span class="badge bg-danger p-2"><i class="bi bi-shield-check me-1"></i> 100% Hàng chính hãng</span>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <h5 class="footer-heading">Thông tin & Chính sách</h5>
                    <ul class="footer-links">
                        <li><a href="#">Mua hàng và thanh toán Online</a></li>
                        <li><a href="#">Mua hàng trả góp 0% Online</a></li>
                        <li><a href="#">Chính sách giao hàng toàn quốc</a></li>
                        <li><a href="#">Chính sách bảo hành đổi mới</a></li>
                        <li><a href="#">Chính sách bảo mật thông tin</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3">
                    <h5 class="footer-heading">Dịch vụ & Tiện ích</h5>
                    <ul class="footer-links">
                        <li><a href="#">Thu cũ đổi mới - Lên đời trợ giá</a></li>
                        <li><a href="#">Dịch vụ bảo hành mở rộng</a></li>
                        <li><a href="#">Chính sách thành viên Smember</a></li>
                        <li><a href="#">Hóa đơn điện tử VAT</a></li>
                        <li><a href="#">Tra cứu đơn hàng trực tuyến</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-3">
                    <h5 class="footer-heading">Phương thức thanh toán</h5>
                    <div class="d-flex flex-wrap gap-2 fs-3 text-secondary mb-3">
                        <i class="bi bi-credit-card-2-front" title="Thẻ ATM / Visa / Master"></i>
                        <i class="bi bi-qr-code" title="Chuyển khoản VNPAY / VietQR"></i>
                        <i class="bi bi-wallet2" title="Ví điện tử MoMo / ZaloPay"></i>
                        <i class="bi bi-cash-stack" title="Thanh toán khi nhận hàng (COD)"></i>
                    </div>
                    <h5 class="footer-heading">Kết nối với chúng tôi</h5>
                    <div class="d-flex gap-2 fs-5">
                        <a href="#" class="text-danger"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-danger"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="text-danger"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>
            </div>

            <hr class="my-3 text-muted" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-muted small">
                <div>
                    &copy; 2026 <strong>Blazor Shop</strong> - Blazor Interactive Server & PostgreSQL.
                </div>
                <div class="mt-2 mt-md-0">
                    Thiết kế đồng bộ phong cách CellphoneS Đỏ - Trắng hiện đại.
                </div>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi không mong muốn.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string searchKeyword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Cart.OnChange += StateHasChanged;
        Auth.OnChange += StateHasChanged;
        await Auth.EnsureInitializedAsync();
    }

    private void HandleSearch()
    {
        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            Navigation.NavigateTo($"products?search={Uri.EscapeDataString(searchKeyword.Trim())}");
        }
        else
        {
            Navigation.NavigateTo("products");
        }
    }

    public void Dispose()
    {
        Cart.OnChange -= StateHasChanged;
        Auth.OnChange -= StateHasChanged;
    }
}
