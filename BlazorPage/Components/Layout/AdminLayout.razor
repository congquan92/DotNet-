@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthService Auth

<div class="page d-flex flex-column min-vh-100">
    <div class="d-flex flex-grow-1">
        <!-- Sidebar Admin -->
        <div class="sidebar bg-dark text-white" style="width: 260px; min-height: 100vh;">
            <AdminNavMenu />
        </div>

        <!-- Main Content -->
        <main class="flex-grow-1 bg-light d-flex flex-column">
            <!-- Topbar Admin -->
            <header class="bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center shadow-sm">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger">Admin Mode</span>
                    <span class="text-muted small">Hệ thống quản lý thương mại điện tử</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="fw-semibold">
                        Xin chào, <span class="text-primary">@(Auth.CurrentUser?.FullName ?? "Administrator")</span>
                    </span>
                    <a class="btn btn-sm btn-outline-danger" href="/api/auth/logout">
                        Đăng xuất
                    </a>
                </div>
            </header>

            <!-- Page Body -->
            <div class="p-4 flex-grow-1">
                @Body
            </div>

            <!-- Footer -->
            <footer class="bg-white border-top py-2 px-4 text-center text-muted small">
                Blazor E-Commerce Admin Panel &copy; 2026 - PostgreSQL Database
            </footer>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi không mong muốn.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureInitializedAsync();
        if (!Auth.IsLoggedIn || !Auth.IsAdmin)
        {
            Navigation.NavigateTo("login");
        }
    }
}
